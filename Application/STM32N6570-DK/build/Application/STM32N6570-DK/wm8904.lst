  95:Src/wm8904.c  **** /**
  96:Src/wm8904.c  ****   * @brief Initializes the audio codec and the control interface.
  97:Src/wm8904.c  ****   * @param pObj pointer to component object
  98:Src/wm8904.c  ****   * @param pInit pointer de component init structure
  99:Src/wm8904.c  ****   * @retval 0 if correct communication, else wrong communication
 100:Src/wm8904.c  ****   */
 101:Src/wm8904.c  **** int32_t WM8904_Init(WM8904_Object_t *pObj, WM8904_Init_t *pInit)
 102:Src/wm8904.c  **** {
 103:Src/wm8904.c  ****   int32_t ret = WM8904_OK;
 104:Src/wm8904.c  ****   uint16_t tmp;
 105:Src/wm8904.c  **** 
 106:Src/wm8904.c  ****   if (pObj->IsInitialized == 1U)
 107:Src/wm8904.c  ****   {
 108:Src/wm8904.c  ****     ret += WM8904_DeInit(pObj);
 109:Src/wm8904.c  ****   }
 110:Src/wm8904.c  **** 
 111:Src/wm8904.c  ****   /*********/
 112:Src/wm8904.c  ****   /* Reset */
 113:Src/wm8904.c  ****   /*********/
 114:Src/wm8904.c  **** 
 115:Src/wm8904.c  ****   tmp = 0x0U; /* Reset registers */
 116:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_SW_RESET, &tmp, 2U);
 117:Src/wm8904.c  **** 
 118:Src/wm8904.c  ****   /**************/
 119:Src/wm8904.c  ****   /* Clock rate */
 120:Src/wm8904.c  ****   /**************/
 121:Src/wm8904.c  **** 
 122:Src/wm8904.c  ****   tmp = 0x0004U; /* CLK_SYS_ENA = 1 */
 123:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_CLOCK_RATES2, &tmp, 2U);
 124:Src/wm8904.c  **** 
 125:Src/wm8904.c  ****   /**************************************/
 126:Src/wm8904.c  ****   /* Reference voltages and master bias */
 127:Src/wm8904.c  ****   /**************************************/
 128:Src/wm8904.c  **** 
 129:Src/wm8904.c  ****   tmp = 0x0018U; /* ISEL[1:0] = 10b, BIAS_EN = 0 */
 130:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_BIAS_CONTROL0, &tmp, 2U);
 131:Src/wm8904.c  **** 
 132:Src/wm8904.c  ****   tmp = 0x0047U; /* VMID_BUF_ENA = 1, VMID_RES[1:0] = 11b, VMID_ENA = 1 */
 133:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_VMID_CONTROL0, &tmp, 2U);
 134:Src/wm8904.c  ****   WM8904_Delay(pObj, 100U);
 135:Src/wm8904.c  **** 
 136:Src/wm8904.c  ****   tmp = 0x0043U; /* VMID_BUF_ENA = 1, VMID_RES[1:0] = 01b, VMID_ENA = 1 */
 137:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_VMID_CONTROL0, &tmp, 2U);
 138:Src/wm8904.c  **** 
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccSzblGd.s 			page 4


 139:Src/wm8904.c  ****   tmp = 0x0019U; /* ISEL[1:0] = 10b, BIAS_EN = 1 */
 140:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_BIAS_CONTROL0, &tmp, 2U);
 141:Src/wm8904.c  **** 
 142:Src/wm8904.c  ****   /********************/
 143:Src/wm8904.c  ****   /* Mic BIAS control */
 144:Src/wm8904.c  ****   /********************/
 145:Src/wm8904.c  **** 
 146:Src/wm8904.c  ****   tmp = 0x0001U; /* MICBIAS_ENA = 1 */
 147:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_MIC_BIAS_CONTROL0, &tmp, 2U);
 148:Src/wm8904.c  **** 
 149:Src/wm8904.c  ****   /**********************/
 150:Src/wm8904.c  ****   /* Power management   */
 151:Src/wm8904.c  ****   /**********************/
 152:Src/wm8904.c  **** 
 153:Src/wm8904.c  ****   if (pInit->InputDevice == WM8904_IN_LINE2)
 154:Src/wm8904.c  ****   {
 155:Src/wm8904.c  ****     tmp = 0x0003U; /* INL_ENA = INR_ENA = 1 */
 156:Src/wm8904.c  ****   }
 157:Src/wm8904.c  ****   else if (pInit->InputDevice == WM8904_IN_MIC1)
 158:Src/wm8904.c  ****   {
 159:Src/wm8904.c  ****     tmp = 0x0002U; /* INL_ENA = 1 */
 160:Src/wm8904.c  ****   }
 161:Src/wm8904.c  ****   else /* WM8904_IN_DIGITAL_MIC2 */
 162:Src/wm8904.c  ****   {
 163:Src/wm8904.c  ****     tmp = 0x0000U; /* INx_ENA = 0 */
 164:Src/wm8904.c  ****   }
 165:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_PWR_MANAGEMENT0, &tmp, 2U);
 166:Src/wm8904.c  **** 
 167:Src/wm8904.c  ****   tmp = 0x0003U; /* HPL_PGA_ENA = HPR_PGA_ENA = 1 */
 168:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_PWR_MANAGEMENT2, &tmp, 2U);
 169:Src/wm8904.c  **** 
 170:Src/wm8904.c  ****   /**************/
 171:Src/wm8904.c  ****   /* Clock rate */
 172:Src/wm8904.c  ****   /**************/
 173:Src/wm8904.c  **** 
 174:Src/wm8904.c  ****   tmp = 0x0006U; /* CLK_DSP_ENA = CLK_SYS_ENA = 1 */
 175:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_CLOCK_RATES2, &tmp, 2U);
 176:Src/wm8904.c  **** 
 177:Src/wm8904.c  ****   /**************/
 178:Src/wm8904.c  ****   /* DAC and ADC*/
 179:Src/wm8904.c  ****   /**************/
 180:Src/wm8904.c  **** 
 181:Src/wm8904.c  ****   if (pInit->InputDevice == WM8904_IN_LINE2)
 182:Src/wm8904.c  ****   {
 183:Src/wm8904.c  ****     tmp = 0x000FU; /* ADCR_ENA = ADCL_ENA = DACL_ENA = DACR_ENA = 1 */
 184:Src/wm8904.c  ****   }
 185:Src/wm8904.c  ****   else if (pInit->InputDevice == WM8904_IN_MIC1)
 186:Src/wm8904.c  ****   {
 187:Src/wm8904.c  ****     tmp = 0x000EU; /* ADCL_ENA = DACL_ENA = DACR_ENA = 1, ADCR_ENA = 0 */
 188:Src/wm8904.c  ****   }
 189:Src/wm8904.c  ****   else /* WM8904_IN_DIGITAL_MIC2 */
 190:Src/wm8904.c  ****   {
 191:Src/wm8904.c  ****     tmp = 0x000EU; /* ADCL_ENA = DACL_ENA = DACR_ENA = 1, ADCR_ENA = 0 */
 192:Src/wm8904.c  ****   }
 193:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_PWR_MANAGEMENT6, &tmp, 2U);
 194:Src/wm8904.c  **** 
 195:Src/wm8904.c  ****   if (pInit->InputDevice == WM8904_IN_DIGITAL_MIC2)
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccSzblGd.s 			page 5


 196:Src/wm8904.c  ****   {
 197:Src/wm8904.c  ****     tmp = 0x1800U; /* DMIC_ENA = 1, DMIC_SRC = IN1R/DMICDAT2 */
 198:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_DIGITAL_MICROPHONE0, &tmp, 2U);
 199:Src/wm8904.c  **** 
 200:Src/wm8904.c  ****     tmp = 0x0008U; /* GPIO1_PU = GPIO1_PD = 0, GPIO1_SEL = 8 (DMIC clock out) */
 201:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_GPIO_CONTROL1, &tmp, 2U);
 202:Src/wm8904.c  **** 
 203:Src/wm8904.c  ****     tmp = 0x81AFU; /* DRC_ENA = 1, DRC_DAC_PATH = ADC */
 204:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_DRC0, &tmp, 2U);
 205:Src/wm8904.c  **** 
 206:Src/wm8904.c  ****     tmp = 0x32C1U; /* DRC_MINGAIN = 0dB, DRC_MAXGAIN = 18dB */
 207:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_DRC1, &tmp, 2U);
 208:Src/wm8904.c  **** 
 209:Src/wm8904.c  ****     tmp = 0x002CU; /* DRC_HIGH_COMP = DRC_LO_COMP = 0 */
 210:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_DRC2, &tmp, 2U);
 211:Src/wm8904.c  **** 
 212:Src/wm8904.c  ****     if (pInit->Frequency >= WM8904_FREQUENCY_32K)
 213:Src/wm8904.c  ****     {
 214:Src/wm8904.c  ****       tmp = 0x0000U; /* ADC_OSR128 = 0 (64xfs) */
 215:Src/wm8904.c  ****     }
 216:Src/wm8904.c  ****     else
 217:Src/wm8904.c  ****     {
 218:Src/wm8904.c  ****       tmp = 0x0001U; /* ADC_OSR128 = 1 (128xfs) */
 219:Src/wm8904.c  ****     }
 220:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_ADC0, &tmp, 2U);
 221:Src/wm8904.c  ****   }
 222:Src/wm8904.c  ****   else
 223:Src/wm8904.c  ****   {
 224:Src/wm8904.c  ****     tmp = 0x0000U; /* DMIC_ENA = 0 */
 225:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_DIGITAL_MICROPHONE0, &tmp, 2U);
 226:Src/wm8904.c  **** 
 227:Src/wm8904.c  ****     tmp = 0x0014U; /* GPIO1_PU = GPIO1_PD = 1, GPIO1_SEL = 4 (IRQ, default value) */
 228:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_GPIO_CONTROL1, &tmp, 2U);
 229:Src/wm8904.c  **** 
 230:Src/wm8904.c  ****     tmp = 0x01AFU; /* DRC_ENA = 0, DRC_DAC_PATH = ADC */
 231:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_DRC0, &tmp, 2U);
 232:Src/wm8904.c  **** 
 233:Src/wm8904.c  ****     tmp = 0x0001U; /* ADC_OSR128 = 1 (128xfs) */
 234:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_ADC0, &tmp, 2U);
 235:Src/wm8904.c  ****   }
 236:Src/wm8904.c  **** 
 237:Src/wm8904.c  ****   tmp = 0x0648U; /* DAC_MUTERATE = DAC_UNMUTE_RAMP = DAC_OSR128 = DAC_MUTE = 1 */
 238:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_DAC_DIGITAL1, &tmp, 2U);
 239:Src/wm8904.c  **** 
 240:Src/wm8904.c  ****   if (pInit->InputDevice == WM8904_IN_LINE2)
 241:Src/wm8904.c  ****   {
 242:Src/wm8904.c  ****     tmp = 0x0050U; /* AIFADCL_SRC = 0 (Left), AIFADCR_SRC = 1 (Right) */
 243:Src/wm8904.c  ****   }
 244:Src/wm8904.c  ****   else if (pInit->InputDevice == WM8904_IN_MIC1)
 245:Src/wm8904.c  ****   {
