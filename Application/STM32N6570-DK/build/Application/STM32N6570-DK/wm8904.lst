 465:Src/wm8904.c  **** {
 466:Src/wm8904.c  ****   int32_t ret;
 467:Src/wm8904.c  ****   uint16_t wm8904_id;
 468:Src/wm8904.c  **** 
 469:Src/wm8904.c  ****   /* Initialize the Control interface of the Audio Codec */
 470:Src/wm8904.c  ****   pObj->IO.Init();
 471:Src/wm8904.c  **** 
 472:Src/wm8904.c  ****   /* Get ID from component */
 473:Src/wm8904.c  ****   ret = wm8904_read_reg(&pObj->Ctx, WM8904_SW_RESET, &wm8904_id, 2U);
 474:Src/wm8904.c  **** 
