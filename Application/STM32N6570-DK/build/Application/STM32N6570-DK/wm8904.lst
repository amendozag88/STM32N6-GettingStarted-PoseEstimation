 812:Src/wm8904.c  **** /**
 813:Src/wm8904.c  ****   * @brief Sets new frequency.
 814:Src/wm8904.c  ****   * @param pObj pointer to component object
 815:Src/wm8904.c  ****   * @param AudioFreq Audio frequency
 816:Src/wm8904.c  ****   * @retval Component status
 817:Src/wm8904.c  ****   */
 818:Src/wm8904.c  **** int32_t WM8904_SetFrequency(WM8904_Object_t *pObj, uint32_t AudioFreq)
 819:Src/wm8904.c  **** {
 820:Src/wm8904.c  ****   int32_t ret;
 821:Src/wm8904.c  ****   uint16_t tmp;
 822:Src/wm8904.c  **** 
 823:Src/wm8904.c  ****   switch (AudioFreq)
 824:Src/wm8904.c  ****   {
 825:Src/wm8904.c  ****   case  WM8904_FREQUENCY_8K:
 826:Src/wm8904.c  ****     /* Sample Rate = 8 (kHz), ratio=256 */
 827:Src/wm8904.c  ****     tmp = 0x0C00U;
 828:Src/wm8904.c  ****     ret = wm8904_write_reg(&pObj->Ctx, WM8904_CLOCK_RATES1, &tmp, 2U);
 829:Src/wm8904.c  ****     break;
 830:Src/wm8904.c  **** 
 831:Src/wm8904.c  ****   case  WM8904_FREQUENCY_11K:
 832:Src/wm8904.c  ****     /* Sample Rate = 11.025 (kHz), ratio=256 */
 833:Src/wm8904.c  ****     tmp = 0x0C01U;
 834:Src/wm8904.c  ****     ret = wm8904_write_reg(&pObj->Ctx, WM8904_CLOCK_RATES1, &tmp, 2U);
 835:Src/wm8904.c  ****     break;
 836:Src/wm8904.c  **** 
 837:Src/wm8904.c  ****   case  WM8904_FREQUENCY_16K:
 838:Src/wm8904.c  ****     /* Sample Rate = 16 (kHz), ratio=256 */
 839:Src/wm8904.c  ****     tmp = 0x0C02U;
 840:Src/wm8904.c  ****     ret = wm8904_write_reg(&pObj->Ctx, WM8904_CLOCK_RATES1, &tmp, 2U);
 841:Src/wm8904.c  ****     break;
 842:Src/wm8904.c  **** 
 843:Src/wm8904.c  ****   case  WM8904_FREQUENCY_22K:
 844:Src/wm8904.c  ****   case  WM8904_FREQUENCY_24K:
 845:Src/wm8904.c  ****     /* Sample Rate = 22.050 (kHz) or 24 (kHz), ratio=256 */
 846:Src/wm8904.c  ****     tmp = 0x0C03U;
 847:Src/wm8904.c  ****     ret = wm8904_write_reg(&pObj->Ctx, WM8904_CLOCK_RATES1, &tmp, 2U);
 848:Src/wm8904.c  ****     break;
 849:Src/wm8904.c  **** 
 850:Src/wm8904.c  ****   case  WM8904_FREQUENCY_32K:
 851:Src/wm8904.c  ****     /* Sample Rate = 32 (kHz), ratio=256 */
 852:Src/wm8904.c  ****     tmp = 0x0C04U;
 853:Src/wm8904.c  ****     ret = wm8904_write_reg(&pObj->Ctx, WM8904_CLOCK_RATES1, &tmp, 2U);
 854:Src/wm8904.c  ****     break;
 855:Src/wm8904.c  **** 
 856:Src/wm8904.c  ****   case  WM8904_FREQUENCY_44K:
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccSzblGd.s 			page 17


 857:Src/wm8904.c  ****   case  WM8904_FREQUENCY_48K:
 858:Src/wm8904.c  ****     /* Sample Rate = 44.1 (kHz) or 48 (kHz), ratio=256 */
 859:Src/wm8904.c  ****     tmp = 0x0C05U;
 860:Src/wm8904.c  ****     ret = wm8904_write_reg(&pObj->Ctx, WM8904_CLOCK_RATES1, &tmp, 2U);
 861:Src/wm8904.c  ****     break;
 862:Src/wm8904.c  **** 
 863:Src/wm8904.c  ****   default:
 864:Src/wm8904.c  ****     ret = WM8904_ERROR;
 865:Src/wm8904.c  ****     break;
 866:Src/wm8904.c  ****   }
 867:Src/wm8904.c  **** 
 868:Src/wm8904.c  ****   return ret;
 869:Src/wm8904.c  **** }
 870:Src/wm8904.c  **** 
 871:Src/wm8904.c  **** /**
 872:Src/wm8904.c  ****   * @brief Get frequency.
 873:Src/wm8904.c  ****   * @param pObj pointer to component object
 874:Src/wm8904.c  ****   * @param AudioFreq Audio frequency
 875:Src/wm8904.c  ****   * @retval Component status
 876:Src/wm8904.c  ****   */
 877:Src/wm8904.c  **** int32_t WM8904_GetFrequency(WM8904_Object_t *pObj, uint32_t *AudioFreq)
 878:Src/wm8904.c  **** {
 879:Src/wm8904.c  ****   int32_t  ret;
 880:Src/wm8904.c  ****   uint16_t tmp;
 881:Src/wm8904.c  **** 
 882:Src/wm8904.c  ****   ret = wm8904_read_reg(&pObj->Ctx, WM8904_CLOCK_RATES1, &tmp, 2U);
 883:Src/wm8904.c  **** 
 884:Src/wm8904.c  ****   switch(tmp & 0x0007U)
 885:Src/wm8904.c  ****   {
 886:Src/wm8904.c  ****   case 0:
 887:Src/wm8904.c  ****     *AudioFreq = WM8904_FREQUENCY_8K;
 888:Src/wm8904.c  ****     break;
 889:Src/wm8904.c  ****   case 1:
 890:Src/wm8904.c  ****     /* 11.025k or 12k */
 891:Src/wm8904.c  ****     *AudioFreq = WM8904_FREQUENCY_11K;
 892:Src/wm8904.c  ****     break;
 893:Src/wm8904.c  ****   case 2:
 894:Src/wm8904.c  ****     *AudioFreq = WM8904_FREQUENCY_16K;
 895:Src/wm8904.c  ****     break;
 896:Src/wm8904.c  ****   case 3:
 897:Src/wm8904.c  ****     /* 22.05k or 24k */
 898:Src/wm8904.c  ****     *AudioFreq = WM8904_FREQUENCY_22K;
 899:Src/wm8904.c  ****     break;
 900:Src/wm8904.c  ****   case 4:
 901:Src/wm8904.c  ****     *AudioFreq = WM8904_FREQUENCY_32K;
 902:Src/wm8904.c  ****     break;
 903:Src/wm8904.c  ****   case 5:
 904:Src/wm8904.c  ****     /* 44.1k or 48k */
 905:Src/wm8904.c  ****     *AudioFreq = WM8904_FREQUENCY_44K;
 906:Src/wm8904.c  ****     break;
 907:Src/wm8904.c  ****   default:
 908:Src/wm8904.c  ****     ret = WM8904_ERROR;
 909:Src/wm8904.c  ****     break;
 910:Src/wm8904.c  ****   }
 911:Src/wm8904.c  **** 
 912:Src/wm8904.c  ****   return ret;
 913:Src/wm8904.c  **** }
