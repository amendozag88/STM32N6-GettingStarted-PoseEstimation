 639:Src/wm8904.c  **** /**
 640:Src/wm8904.c  ****   * @brief Enables or disables the mute feature on the audio codec.
 641:Src/wm8904.c  ****   * @param  pObj pointer to component object
 642:Src/wm8904.c  ****   * @param Cmd  WM8904_MUTE_ON to enable the mute or WM8904_MUTE_OFF to disable the
 643:Src/wm8904.c  ****   *             mute mode.
 644:Src/wm8904.c  ****   * @retval 0 if correct communication, else wrong communication
 645:Src/wm8904.c  ****   */
 646:Src/wm8904.c  **** int32_t WM8904_SetMute(WM8904_Object_t *pObj, uint32_t Cmd)
 647:Src/wm8904.c  **** {
 648:Src/wm8904.c  ****   int32_t ret = WM8904_OK;
 649:Src/wm8904.c  ****   uint16_t tmp;
 650:Src/wm8904.c  **** 
 651:Src/wm8904.c  ****   if ((WM8904_CurrentDevices & WM8904_OUT_HEADPHONE) == WM8904_OUT_HEADPHONE)
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccSzblGd.s 			page 13


 652:Src/wm8904.c  ****   {
 653:Src/wm8904.c  ****     /* Read DAC digital 1 */
 654:Src/wm8904.c  ****     ret += wm8904_read_reg(&pObj->Ctx, WM8904_DAC_DIGITAL1, &tmp, 2U);
 655:Src/wm8904.c  **** 
 656:Src/wm8904.c  ****     if(Cmd == WM8904_MUTE_ON)
 657:Src/wm8904.c  ****     {
 658:Src/wm8904.c  ****       /* Mute the DAC Digital 1 */
 659:Src/wm8904.c  ****       tmp |= 0x0008U;
 660:Src/wm8904.c  ****     }
 661:Src/wm8904.c  ****     else
 662:Src/wm8904.c  ****     {
 663:Src/wm8904.c  ****       /* Unmute the the DAC Digital 1 */
 664:Src/wm8904.c  ****       tmp &= ~(0x0008U);
 665:Src/wm8904.c  ****     }
 666:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_DAC_DIGITAL1, &tmp, 2U);
 667:Src/wm8904.c  ****   }
 668:Src/wm8904.c  **** 
 669:Src/wm8904.c  ****   if ((WM8904_CurrentDevices & WM8904_IN_MIC1) == WM8904_IN_MIC1)
 670:Src/wm8904.c  ****   {
 671:Src/wm8904.c  ****     if(Cmd == WM8904_MUTE_ON)
 672:Src/wm8904.c  ****     {
 673:Src/wm8904.c  ****       tmp = 0x009AU; /* LINMUTE = 1 */
 674:Src/wm8904.c  ****     }
 675:Src/wm8904.c  ****     else
 676:Src/wm8904.c  ****     {
 677:Src/wm8904.c  ****       tmp = 0x001AU; /* LINMUTE = 0 */
 678:Src/wm8904.c  ****     }
 679:Src/wm8904.c  ****     ret +=  wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_LEFT_INPUT0, &tmp, 2U);
 680:Src/wm8904.c  ****   }
 681:Src/wm8904.c  **** 
 682:Src/wm8904.c  ****   if ((WM8904_CurrentDevices & WM8904_IN_LINE2) == WM8904_IN_LINE2)
 683:Src/wm8904.c  ****   {
 684:Src/wm8904.c  ****     if(Cmd == WM8904_MUTE_ON)
 685:Src/wm8904.c  ****     {
 686:Src/wm8904.c  ****       tmp = 0x0080U; /* LINMUTE = 1 */
 687:Src/wm8904.c  ****     }
 688:Src/wm8904.c  ****     else
 689:Src/wm8904.c  ****     {
 690:Src/wm8904.c  ****       tmp = 0x0000U; /* LINMUTE = 0 */
 691:Src/wm8904.c  ****     }
 692:Src/wm8904.c  ****     ret +=  wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_LEFT_INPUT0, &tmp, 2U);
 693:Src/wm8904.c  ****     ret +=  wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_RIGHT_INPUT0, &tmp, 2U);
 694:Src/wm8904.c  ****   }
 695:Src/wm8904.c  **** 
 696:Src/wm8904.c  ****   if ((WM8904_CurrentDevices & WM8904_IN_DIGITAL_MIC2) == WM8904_IN_DIGITAL_MIC2)
 697:Src/wm8904.c  ****   {
 698:Src/wm8904.c  ****     if(Cmd == WM8904_MUTE_ON)
 699:Src/wm8904.c  ****     {
 700:Src/wm8904.c  ****       tmp = 0x0100U; /* ADC_VU = 1, ADC_VOL = Mute */
 701:Src/wm8904.c  ****     }
 702:Src/wm8904.c  ****     else
 703:Src/wm8904.c  ****     {
 704:Src/wm8904.c  ****       tmp = 0x01F0U; /* ADC_VU = 1, ADC_VOL = +17,6dB */
 705:Src/wm8904.c  ****     }
 706:Src/wm8904.c  ****     ret +=  wm8904_write_reg(&pObj->Ctx, WM8904_ADC_DIGITAL_VOL_RIGHT, &tmp, 2U);
 707:Src/wm8904.c  ****   }
 708:Src/wm8904.c  **** 
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccSzblGd.s 			page 14


 709:Src/wm8904.c  ****   return ret;
 710:Src/wm8904.c  **** }
