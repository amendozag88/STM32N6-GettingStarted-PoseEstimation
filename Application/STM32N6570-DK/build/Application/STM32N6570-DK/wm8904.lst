 746:Src/wm8904.c  **** /**
 747:Src/wm8904.c  ****   * @brief Get Audio resolution.
 748:Src/wm8904.c  ****   * @param pObj pointer to component object
 749:Src/wm8904.c  ****   * @retval Audio resolution
 750:Src/wm8904.c  ****   */
 751:Src/wm8904.c  **** int32_t WM8904_GetResolution(WM8904_Object_t *pObj, uint32_t *Resolution)
 752:Src/wm8904.c  **** {
 753:Src/wm8904.c  ****   int32_t  ret;
 754:Src/wm8904.c  ****   uint16_t tmp;
 755:Src/wm8904.c  **** 
 756:Src/wm8904.c  ****   ret = wm8904_read_reg(&pObj->Ctx, WM8904_AUDIO_INTERFACE1, &tmp, 2U);
 757:Src/wm8904.c  **** 
 758:Src/wm8904.c  ****   switch((tmp >> 2U) & 0x0003U)
 759:Src/wm8904.c  ****   {
 760:Src/wm8904.c  ****     case 1:
 761:Src/wm8904.c  ****       *Resolution = WM8904_RESOLUTION_20B;
 762:Src/wm8904.c  ****       break;
 763:Src/wm8904.c  ****     case 2:
 764:Src/wm8904.c  ****       *Resolution = WM8904_RESOLUTION_24B;
 765:Src/wm8904.c  ****       break;
 766:Src/wm8904.c  ****     case 3:
 767:Src/wm8904.c  ****       *Resolution = WM8904_RESOLUTION_32B;
 768:Src/wm8904.c  ****       break;
 769:Src/wm8904.c  ****     case 0:
 770:Src/wm8904.c  ****     default:
 771:Src/wm8904.c  ****       *Resolution = WM8904_RESOLUTION_16B;
 772:Src/wm8904.c  ****       break;
 773:Src/wm8904.c  ****   }
 774:Src/wm8904.c  **** 
 775:Src/wm8904.c  ****   return ret;
 776:Src/wm8904.c  **** }
