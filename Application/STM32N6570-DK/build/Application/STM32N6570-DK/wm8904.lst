 254:Src/wm8904.c  ****   /**********************************************/
 255:Src/wm8904.c  ****   /* Resolution, protocol, frequency and volume */
 256:Src/wm8904.c  ****   /**********************************************/
 257:Src/wm8904.c  **** 
 258:Src/wm8904.c  ****   tmp = 0x0002U; /* Set resolution to 16B and protocol to I2S*/
 259:Src/wm8904.c  ****   ret +=  wm8904_write_reg(&pObj->Ctx, WM8904_AUDIO_INTERFACE1, &tmp, 2U);
