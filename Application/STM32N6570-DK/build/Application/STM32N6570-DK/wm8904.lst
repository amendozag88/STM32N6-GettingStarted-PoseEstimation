 277:Src/wm8904.c  ****     ret +=  wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_LEFT_INPUT0, &tmp, 2U);
 278:Src/wm8904.c  **** 
 279:Src/wm8904.c  ****     tmp = 0x0080U; /* LINMUTE = 1, LIN_VOL = -1.5dB */
 280:Src/wm8904.c  ****     ret +=  wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_RIGHT_INPUT0, &tmp, 2U);
