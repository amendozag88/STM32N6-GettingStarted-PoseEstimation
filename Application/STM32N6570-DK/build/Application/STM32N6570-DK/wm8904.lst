 433:Src/wm8904.c  **** 
 434:Src/wm8904.c  ****   tmp = 0x0042U; /* VMID_BUF_ENA = 1, VMID_RES[1:0] = 01b, VMID_ENA = 0 */
 435:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_VMID_CONTROL0, &tmp, 2U);
 436:Src/wm8904.c  **** 
 437:Src/wm8904.c  ****   tmp = 0x0000U; /* VMID_BUF_ENA = 0, VMID_RES[1:0] = 00b, VMID_ENA = 0 */
 438:Src/wm8904.c  ****   ret += wm8904_write_reg(&pObj->Ctx, WM8904_VMID_CONTROL0, &tmp, 2U);
 439:Src/wm8904.c  **** 
 440:Src/wm8904.c  ****   tmp = 0x0018U; /* ISEL[1:0] = 10b,  BIAS_EN = 0 */
