 480:Src/wm8904.c  **** /**
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccSzblGd.s 			page 10


 481:Src/wm8904.c  ****   * @brief Start the audio Codec play feature.
 482:Src/wm8904.c  ****   * @note For this codec no Play options are required.
 483:Src/wm8904.c  ****   * @param  pObj pointer to component object
 484:Src/wm8904.c  ****   * @retval Component status
 485:Src/wm8904.c  ****   */
 486:Src/wm8904.c  **** int32_t WM8904_Play(WM8904_Object_t *pObj)
 487:Src/wm8904.c  **** {
 488:Src/wm8904.c  ****   int32_t ret = WM8904_OK;
 489:Src/wm8904.c  ****   uint16_t tmp;
 490:Src/wm8904.c  **** 
 491:Src/wm8904.c  ****   if ((WM8904_CurrentDevices & WM8904_OUT_HEADPHONE) == WM8904_OUT_HEADPHONE)
 492:Src/wm8904.c  ****   {
 493:Src/wm8904.c  ****     tmp = 0x0640U; /* DAC_MUTE= 0 */
 494:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_DAC_DIGITAL1, &tmp, 2U);
 495:Src/wm8904.c  ****   }
 496:Src/wm8904.c  **** 
 497:Src/wm8904.c  **** 
 498:Src/wm8904.c  ****   if ((WM8904_CurrentDevices & WM8904_IN_MIC1) == WM8904_IN_MIC1)
 499:Src/wm8904.c  ****   {
 500:Src/wm8904.c  ****     tmp = 0x001AU; /* LINMUTE = 0 */
 501:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_LEFT_INPUT0, &tmp, 2U);
 502:Src/wm8904.c  ****   }
 503:Src/wm8904.c  **** 
 504:Src/wm8904.c  ****   if ((WM8904_CurrentDevices & WM8904_IN_LINE2) == WM8904_IN_LINE2)
 505:Src/wm8904.c  ****   {
 506:Src/wm8904.c  ****     tmp = 0x0000U; /* LINMUTE = 0 */
 507:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_LEFT_INPUT0, &tmp, 2U);
 508:Src/wm8904.c  **** 
 509:Src/wm8904.c  ****     tmp = 0x0000U; /* LINMUTE = 0 */
 510:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_RIGHT_INPUT0, &tmp, 2U);
 511:Src/wm8904.c  ****   }
 512:Src/wm8904.c  **** 
 513:Src/wm8904.c  ****   if ((WM8904_CurrentDevices & WM8904_IN_DIGITAL_MIC2) == WM8904_IN_DIGITAL_MIC2)
 514:Src/wm8904.c  ****   {
 515:Src/wm8904.c  ****     tmp = 0x01F0U; /* ADC_VU = 1, ADC_VOL = +17,6dB */
 516:Src/wm8904.c  ****     ret +=  wm8904_write_reg(&pObj->Ctx, WM8904_ADC_DIGITAL_VOL_LEFT, &tmp, 2U);
 517:Src/wm8904.c  ****   }
 518:Src/wm8904.c  **** 
 519:Src/wm8904.c  ****   return ret;
 520:Src/wm8904.c  **** }
 521:Src/wm8904.c  **** 
 522:Src/wm8904.c  **** /**
 523:Src/wm8904.c  ****   * @brief Pauses playing on the audio codec.
 524:Src/wm8904.c  ****   * @param  pObj pointer to component object
 525:Src/wm8904.c  ****   * @retval Component status
 526:Src/wm8904.c  ****   */
 527:Src/wm8904.c  **** int32_t WM8904_Pause(WM8904_Object_t *pObj)
 528:Src/wm8904.c  **** {
 529:Src/wm8904.c  ****   /* Pause the audio file playing */
 530:Src/wm8904.c  ****   return WM8904_SetMute(pObj, WM8904_MUTE_ON);
 531:Src/wm8904.c  **** }
 532:Src/wm8904.c  **** 
 533:Src/wm8904.c  **** /**
 534:Src/wm8904.c  ****   * @brief Resumes playing on the audio codec.
 535:Src/wm8904.c  ****   * @param  pObj pointer to component object
 536:Src/wm8904.c  ****   * @retval Component status
 537:Src/wm8904.c  ****   */
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccSzblGd.s 			page 11


 538:Src/wm8904.c  **** int32_t WM8904_Resume(WM8904_Object_t *pObj)
 539:Src/wm8904.c  **** {
 540:Src/wm8904.c  ****   /* Resumes the audio file playing */
 541:Src/wm8904.c  ****   return WM8904_SetMute(pObj, WM8904_MUTE_OFF);
 542:Src/wm8904.c  **** }
 543:Src/wm8904.c  **** 
 544:Src/wm8904.c  **** /**
 545:Src/wm8904.c  ****   * @brief Stops audio Codec playing. It powers down the codec.
 546:Src/wm8904.c  ****   * @param  pObj pointer to component object
 547:Src/wm8904.c  ****   * @param CodecPdwnMode  selects the  power down mode.
 548:Src/wm8904.c  ****   *          - WM8904_PDWN_SW: only mutes the audio codec. When resuming from this
 549:Src/wm8904.c  ****   *                           mode the codec keeps the previous initialization
 550:Src/wm8904.c  ****   *                           (no need to re-Initialize the codec registers).
 551:Src/wm8904.c  ****   *          - WM8904_PDWN_HW: Physically power down the codec. When resuming from this
 552:Src/wm8904.c  ****   *                           mode, the codec is set to default configuration
 553:Src/wm8904.c  ****   *                           (user should re-Initialize the codec in order to
 554:Src/wm8904.c  ****   *                            play again the audio stream).
 555:Src/wm8904.c  ****   * @retval 0 if correct communication, else wrong communication
 556:Src/wm8904.c  ****   */
 557:Src/wm8904.c  **** int32_t WM8904_Stop(WM8904_Object_t *pObj, uint32_t CodecPdwnMode)
 558:Src/wm8904.c  **** {
 559:Src/wm8904.c  ****   int32_t ret;
 560:Src/wm8904.c  **** 
 561:Src/wm8904.c  ****   /* Mute the output */
 562:Src/wm8904.c  ****   ret = WM8904_SetMute(pObj, WM8904_MUTE_ON);
 563:Src/wm8904.c  **** 
 564:Src/wm8904.c  ****   if (CodecPdwnMode == WM8904_PDWN_HW)
 565:Src/wm8904.c  ****   {
 566:Src/wm8904.c  ****     ret += WM8904_DeInit(pObj);
 567:Src/wm8904.c  ****   }
 568:Src/wm8904.c  **** 
 569:Src/wm8904.c  ****   return ret;
 570:Src/wm8904.c  **** }
 571:Src/wm8904.c  **** 
 572:Src/wm8904.c  **** /**
 573:Src/wm8904.c  ****   * @brief Set higher or lower the codec volume level.
 574:Src/wm8904.c  ****   * @param  pObj pointer to component object
 575:Src/wm8904.c  ****   * @param  InputOutput Input or Output volume
 576:Src/wm8904.c  ****   * @param  Volume  a byte value from 0 to 100.
 577:Src/wm8904.c  ****   *         (refer to codec registers description for more details).
 578:Src/wm8904.c  ****   * @retval Component status
 579:Src/wm8904.c  ****   */
 580:Src/wm8904.c  **** int32_t WM8904_SetVolume(WM8904_Object_t *pObj, uint32_t InputOutput, uint8_t Volume)
 581:Src/wm8904.c  **** {
 582:Src/wm8904.c  ****   uint8_t  convertedvol;
 583:Src/wm8904.c  ****   int32_t  ret;
 584:Src/wm8904.c  ****   uint16_t tmp;
 585:Src/wm8904.c  **** 
 586:Src/wm8904.c  ****   /* Only output volume supported */
 587:Src/wm8904.c  ****   if (InputOutput == VOLUME_OUTPUT)
 588:Src/wm8904.c  ****   {
 589:Src/wm8904.c  ****     convertedvol = VOLUME_OUT_CONVERT(Volume);
 590:Src/wm8904.c  **** 
 591:Src/wm8904.c  ****     tmp = (uint16_t) convertedvol;
 592:Src/wm8904.c  **** 
 593:Src/wm8904.c  ****     /* Left Headphone Volume */
 594:Src/wm8904.c  ****     ret = wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_OUTPUT1_LEFT, &tmp, 2U);
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccSzblGd.s 			page 12


 595:Src/wm8904.c  ****     /* Right Headphone Volume */
 596:Src/wm8904.c  ****     tmp |= 0x80U; /* Volume update */
 597:Src/wm8904.c  ****     ret += wm8904_write_reg(&pObj->Ctx, WM8904_ANALOG_OUTPUT1_RIGHT, &tmp, 2U);
 598:Src/wm8904.c  ****   }
 599:Src/wm8904.c  ****   else /* Input volume */
 600:Src/wm8904.c  ****   {
 601:Src/wm8904.c  ****     ret = WM8904_ERROR;
 602:Src/wm8904.c  ****   }
 603:Src/wm8904.c  **** 
 604:Src/wm8904.c  ****   return ret;
 605:Src/wm8904.c  **** }
 606:Src/wm8904.c  **** 
 607:Src/wm8904.c  **** /**
 608:Src/wm8904.c  ****   * @brief Get higher or lower the codec volume level.
 609:Src/wm8904.c  ****   * @param  pObj pointer to component object
 610:Src/wm8904.c  ****   * @param  InputOutput Input or Output volume
 611:Src/wm8904.c  ****   * @param  Volume audio volume
 612:Src/wm8904.c  ****   * @retval Component status
 613:Src/wm8904.c  ****   */
 614:Src/wm8904.c  **** int32_t WM8904_GetVolume(WM8904_Object_t *pObj, uint32_t InputOutput, uint8_t *Volume)
 615:Src/wm8904.c  **** {
 616:Src/wm8904.c  ****   int32_t  ret;
 617:Src/wm8904.c  ****   uint16_t tmp;
 618:Src/wm8904.c  **** 
 619:Src/wm8904.c  ****   /* only output volume supported */
 620:Src/wm8904.c  ****   if (InputOutput == VOLUME_OUTPUT)
 621:Src/wm8904.c  ****   {
 622:Src/wm8904.c  ****     /* Left Headphone Volume */
 623:Src/wm8904.c  ****     ret = wm8904_read_reg(&pObj->Ctx, WM8904_ANALOG_OUTPUT1_LEFT, &tmp, 2U);
 624:Src/wm8904.c  ****     tmp &= 0x3FU;
 625:Src/wm8904.c  **** 
 626:Src/wm8904.c  ****     if (ret == WM8904_OK)
 627:Src/wm8904.c  ****     {
