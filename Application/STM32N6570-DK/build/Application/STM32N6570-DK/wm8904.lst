 629:Src/wm8904.c  ****     }
 630:Src/wm8904.c  ****   }
 631:Src/wm8904.c  ****   else /* Input volume */
 632:Src/wm8904.c  ****   {
 633:Src/wm8904.c  ****     ret = WM8904_ERROR;
 634:Src/wm8904.c  ****   }
 635:Src/wm8904.c  **** 
 636:Src/wm8904.c  ****   return ret;
 637:Src/wm8904.c  **** }
