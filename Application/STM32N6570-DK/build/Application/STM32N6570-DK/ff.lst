1510:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					obj->stat = 2;	/* Change the chain status 'contiguous' */
1511:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				}
