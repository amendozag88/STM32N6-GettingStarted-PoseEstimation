  46:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
  47:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* Character code support macros */
  48:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define IsUpper(c)		((c) >= 'A' && (c) <= 'Z')
  49:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define IsLower(c)		((c) >= 'a' && (c) <= 'z')
  50:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define IsDigit(c)		((c) >= '0' && (c) <= '9')
  51:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define IsSeparator(c)	((c) == '/' || (c) == '\\')
  52:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define IsTerminator(c)	((UINT)(c) < (FF_USE_LFN ? ' ' : '!'))
  53:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define IsSurrogate(c)	((c) >= 0xD800 && (c) <= 0xDFFF)
  54:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define IsSurrogateH(c)	((c) >= 0xD800 && (c) <= 0xDBFF)
  55:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define IsSurrogateL(c)	((c) >= 0xDC00 && (c) <= 0xDFFF)
  56:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
  57:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
  58:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* Additional file access control and file status flags for internal use */
  59:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define FA_SEEKEND	0x20	/* Seek to end of the file on file open */
  60:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define FA_MODIFIED	0x40	/* File has been modified */
  61:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define FA_DIRTY	0x80	/* FIL.buf[] needs to be written-back */
