 773:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		} while (--nf != 0);
 774:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (uc < 0x80 || IsSurrogate(uc) || uc >= 0x110000) return 0xFFFFFFFF;	/* Wrong code? */
