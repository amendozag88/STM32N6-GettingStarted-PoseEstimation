 996:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
 997:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (i == FF_FS_LOCK) {			/* Not opened. Register it as new. */
 998:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		for (i = 0; i < FF_FS_LOCK && Files[i].fs; i++) ;	/* Find a free entry */
 999:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (i == FF_FS_LOCK) return 0;	/* No free entry to register (int err) */
