1404:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1405:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static FRESULT fill_last_frag (
1406:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FFOBJID* obj,	/* Pointer to the corresponding object */
1407:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD lcl,		/* Last cluster of the fragment */
1408:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD term		/* Value to set the last FAT entry */
1409:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
1410:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
1411:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FRESULT res;
1412:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1413:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1414:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	while (obj->n_frag > 0) {	/* Create the chain of last fragment */
1415:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		res = put_fat(obj->fs, lcl - obj->n_frag + 1, (obj->n_frag > 1) ? lcl - obj->n_frag + 2 : term);
1416:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (res != FR_OK) return res;
1417:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		obj->n_frag--;
1418:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
1419:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return FR_OK;
1420:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
