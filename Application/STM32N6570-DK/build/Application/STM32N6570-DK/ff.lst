2259:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* exFAT: Create a new directory entry block */
2260:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*-------------------------------------------*/
2261:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2262:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static void create_xdir (
2263:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE* dirb,			/* Pointer to the directory entry block buffer */
2264:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	const WCHAR* lfn	/* Pointer to the object name */
2265:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
2266:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
2267:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT i;
2268:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE nc1, nlen;
2269:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	WCHAR wc;
2270:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2271:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2272:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Create file-directory and stream-extension entry */
2273:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	memset(dirb, 0, 2 * SZDIRE);
2274:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	dirb[0 * SZDIRE + XDIR_Type] = ET_FILEDIR;
2275:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	dirb[1 * SZDIRE + XDIR_Type] = ET_STREAM;
2276:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2277:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Create file-name entries */
2278:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	i = SZDIRE * 2;	/* Top of file_name entries */
2279:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	nlen = nc1 = 0; wc = 1;
2280:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	do {
2281:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		dirb[i++] = ET_FILENAME; dirb[i++] = 0;
2282:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		do {	/* Fill name field */
2283:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (wc != 0 && (wc = lfn[nlen]) != 0) nlen++;	/* Get a character if exist */
2284:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			st_word(dirb + i, wc); 	/* Store it */
2285:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			i += 2;
2286:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		} while (i % SZDIRE != 0);
2287:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		nc1++;
2288:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	} while (lfn[nlen]);	/* Fill next entry if any char follows */
2289:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2290:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	dirb[XDIR_NumName] = nlen;		/* Set name length */
2291:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	dirb[XDIR_NumSec] = 1 + nc1;	/* Set secondary count (C0 + C1s) */
2292:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	st_word(dirb + XDIR_NameHash, xname_sum(lfn));	/* Set name hash */
2293:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
2294:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2295:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif	/* !FF_FS_READONLY */
2296:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif	/* FF_FS_EXFAT */
2297:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2298:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2299:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2300:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if FF_FS_MINIMIZE <= 1 || FF_FS_RPATH >= 2 || FF_USE_LABEL || FF_FS_EXFAT
