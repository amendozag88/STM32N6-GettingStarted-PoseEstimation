1569:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				res = fill_last_frag(obj, clst, ncl);	/* Fill last fragment on the FAT and link it to new one *
1570:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (res == FR_OK) obj->n_frag = 1;
1571:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			}
