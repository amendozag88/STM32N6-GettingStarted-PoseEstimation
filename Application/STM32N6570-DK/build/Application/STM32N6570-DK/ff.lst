2812:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (*pat == 0 && skip) return 1;	/* Matched? (short circuit) */
2813:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
