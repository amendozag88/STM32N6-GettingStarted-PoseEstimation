3292:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3293:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static UINT check_fs (	/* 0:FAT/FAT32 VBR, 1:exFAT VBR, 2:Not FAT and valid BS, 3:Not FAT and inval
3294:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FATFS* fs,			/* Filesystem object */
3295:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	LBA_t sect			/* Sector to load and check if it is an FAT-VBR or not */
3296:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
3297:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
3298:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	WORD w, sign;
3299:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE b;
3300:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3301:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3302:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	fs->wflag = 0; fs->winsect = (LBA_t)0 - 1;		/* Invaidate window */
3303:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (move_window(fs, sect) != FR_OK) return 4;	/* Load the boot sector */
3304:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	sign = ld_word(fs->win + BS_55AA);
3305:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if FF_FS_EXFAT
3306:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (sign == 0xAA55 && !memcmp(fs->win + BS_JmpBoot, "\xEB\x76\x90" "EXFAT   ", 11)) return 1;	/* I
3307:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
3308:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	b = fs->win[BS_JmpBoot];
3309:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (b == 0xEB || b == 0xE9 || b == 0xE8) {	/* Valid JumpBoot code? (short jump, near jump or near 
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccTbTRBb.s 			page 63


3310:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (sign == 0xAA55 && !memcmp(fs->win + BS_FilSysType32, "FAT32   ", 8)) {
3311:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			return 0;	/* It is an FAT32 VBR */
3312:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
3313:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		/* FAT volumes formatted with early MS-DOS lack BS_55AA and BS_FilSysType, so FAT VBR needs to be
3314:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		w = ld_word(fs->win + BPB_BytsPerSec);
3315:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		b = fs->win[BPB_SecPerClus];
3316:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if ((w & (w - 1)) == 0 && w >= FF_MIN_SS && w <= FF_MAX_SS	/* Properness of sector size (512-4096
3317:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			&& b != 0 && (b & (b - 1)) == 0				/* Properness of cluster size (2^n) */
3318:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			&& ld_word(fs->win + BPB_RsvdSecCnt) != 0	/* Properness of reserved sectors (MNBZ) */
3319:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			&& (UINT)fs->win[BPB_NumFATs] - 1 <= 1		/* Properness of FATs (1 or 2) */
3320:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			&& ld_word(fs->win + BPB_RootEntCnt) != 0	/* Properness of root dir entries (MNBZ) */
3321:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			&& (ld_word(fs->win + BPB_TotSec16) >= 128 || ld_dword(fs->win + BPB_TotSec32) >= 0x10000)	/* Pr
3322:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			&& ld_word(fs->win + BPB_FATSz16) != 0) {	/* Properness of FAT size (MNBZ) */
3323:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				return 0;	/* It can be presumed an FAT VBR */
3324:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
3325:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
3326:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return sign == 0xAA55 ? 2 : 3;	/* Not an FAT VBR (valid or invalid BS) */
3327:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
