 764:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		} else if ((uc & 0xF8) == 0xF0) {	/* 4-byte sequence? */
 765:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			uc &= 0x07; nf = 3;
 766:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		} else {							/* Wrong sequence */
 767:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			return 0xFFFFFFFF;
