3265:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static DWORD make_rand (
3266:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD seed,		/* Seed value */
3267:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE *buff,		/* Output buffer */
3268:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT n			/* Data length */
3269:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
3270:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
3271:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT r;
3272:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3273:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3274:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (seed == 0) seed = 1;
3275:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	do {
3276:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		for (r = 0; r < 8; r++) seed = seed & 1 ? seed >> 1 ^ 0xA3000000 : seed >> 1;	/* Shift 8 bits the
3277:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		*buff++ = (BYTE)seed;
3278:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	} while (--n);
3279:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return seed;
3280:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
