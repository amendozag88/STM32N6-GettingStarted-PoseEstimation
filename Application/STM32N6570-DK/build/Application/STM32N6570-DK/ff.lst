2226:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*----------------------------------------*/
2227:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* exFAT: Store the directory entry block */
2228:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*----------------------------------------*/
2229:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2230:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static FRESULT store_xdir (
2231:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DIR* dp				/* Pointer to the directory object */
2232:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
2233:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
2234:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FRESULT res;
2235:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT nent;
2236:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE *dirb = dp->obj.fs->dirbuf;	/* Pointer to the directory entry block 85+C0+C1s */
2237:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2238:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Create set sum */
2239:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	st_word(dirb + XDIR_SetSum, xdir_sum(dirb));
2240:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	nent = dirb[XDIR_NumSec] + 1;
2241:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2242:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Store the directory entry block to the directory */
2243:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	res = dir_sdi(dp, dp->blk_ofs);
2244:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	while (res == FR_OK) {
2245:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		res = move_window(dp->obj.fs, dp->sect);
2246:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (res != FR_OK) break;
2247:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		memcpy(dp->dir, dirb, SZDIRE);
2248:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		dp->obj.fs->wflag = 1;
2249:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (--nent == 0) break;
2250:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		dirb += SZDIRE;
2251:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		res = dir_next(dp, 0);
2252:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccTbTRBb.s 			page 43


2253:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return (res == FR_OK || res == FR_DISK_ERR) ? res : FR_INT_ERR;
2254:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
