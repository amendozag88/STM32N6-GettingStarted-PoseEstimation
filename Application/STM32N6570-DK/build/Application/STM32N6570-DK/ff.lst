 791:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		wc = (wc << 8) + b;		/* Make a DBC */
 792:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
 793:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (wc != 0) {
