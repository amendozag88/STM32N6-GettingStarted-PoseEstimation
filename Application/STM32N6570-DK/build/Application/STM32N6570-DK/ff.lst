 740:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
 741:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD uc;
 742:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	const TCHAR *p = *str;
 743:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
 744:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if FF_LFN_UNICODE == 1		/* UTF-16 input */
 745:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	WCHAR wc;
 746:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
 747:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	uc = *p++;	/* Get a unit */
 748:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (IsSurrogate(uc)) {	/* Surrogate? */
 749:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		wc = *p++;		/* Get low surrogate */
 750:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (!IsSurrogateH(uc) || !IsSurrogateL(wc)) return 0xFFFFFFFF;	/* Wrong surrogate? */
 751:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		uc = uc << 16 | wc;
 752:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
