1809:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DIR* dp,				/* Pointer to the directory object */
1810:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT n_ent				/* Number of contiguous entries to allocate */
1811:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
1812:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
1813:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FRESULT res;
1814:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT n;
