 953:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
 954:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Search open object table for the object */
 955:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	be = 0;
