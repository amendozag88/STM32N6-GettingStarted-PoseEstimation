1818:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	res = dir_sdi(dp, 0);
1819:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (res == FR_OK) {
1820:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		n = 0;
1821:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		do {
