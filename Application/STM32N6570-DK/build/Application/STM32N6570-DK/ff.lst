 721:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #elif FF_CODE_PAGE >= 900	/* DBCS fixed code page */
 722:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (c >= DbcTbl[4]) {
 723:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (c <= DbcTbl[5]) return 1;
 724:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (c >= DbcTbl[6] && c <= DbcTbl[7]) return 1;
 725:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (c >= DbcTbl[8] && c <= DbcTbl[9]) return 1;
 726:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
 727:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #else						/* SBCS fixed code page */
 728:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (c != 0) return 0;	/* Always false */
 729:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
 730:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return 0;
 731:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
