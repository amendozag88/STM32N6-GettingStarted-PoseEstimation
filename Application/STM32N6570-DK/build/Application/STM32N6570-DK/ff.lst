1458:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (nxt == 0) break;				/* Empty cluster? */
1459:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (nxt == 1) return FR_INT_ERR;	/* Internal error? */
1460:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (nxt == 0xFFFFFFFF) return FR_DISK_ERR;	/* Disk error? */
1461:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (!FF_FS_EXFAT || fs->fs_type != FS_EXFAT) {
1462:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			res = put_fat(fs, clst, 0);		/* Mark the cluster 'free' on the FAT */
1463:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (res != FR_OK) return res;
1464:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1465:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (fs->free_clst < fs->n_fatent - 2) {	/* Update FSINFO */
1466:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			fs->free_clst++;
1467:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			fs->fsi_flag |= 1;
1468:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1469:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if FF_FS_EXFAT || FF_USE_TRIM
1470:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (ecl + 1 == nxt) {	/* Is next cluster contiguous? */
1471:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			ecl = nxt;
