2826:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				} while (*pptr == '\?' || *pptr == '*');
2827:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (pattern_match(pptr, nptr, sk, recur - 1)) return 1;	/* Test new branch (recursive call) */
