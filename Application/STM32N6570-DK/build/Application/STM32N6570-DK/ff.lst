 737:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static DWORD tchar2uni (	/* Returns a character in UTF-16 encoding (>=0x10000 on surrogate pair, 0x
 738:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	const TCHAR** str		/* Pointer to pointer to TCHAR string in configured encoding */
