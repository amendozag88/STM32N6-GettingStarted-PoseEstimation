1205:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					val = (cofs == clen) ? 0x7FFFFFFF : clst + 1;	/* No data on the FAT, generate the value */
1206:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					break;
1207:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				}
1208:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (obj->stat == 3 && cofs < obj->n_cont) {	/* Is it in the 1st fragment? */
1209:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					val = clst + 1; 	/* Generate the value */
1210:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					break;
1211:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				}
1212:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (obj->stat != 2) {	/* Get value from FAT if FAT chain is valid */
1213:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					if (obj->n_frag != 0) {	/* Is it on the growing edge? */
1214:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 						val = 0x7FFFFFFF;	/* Generate EOC */
1215:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					} else {
1216:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 						if (move_window(fs, fs->fatbase + (clst / (SS(fs) / 4))) != FR_OK) break;
1217:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 						val = ld_dword(fs->win + clst * 4 % SS(fs)) & 0x7FFFFFFF;
1218:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					}
1219:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					break;
1220:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				}
1221:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			}
1222:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			val = 1;	/* Internal error */
1223:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			break;
1224:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
1225:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		default:
1226:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			val = 1;	/* Internal error */
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccTbTRBb.s 			page 25


1227:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1228:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
1229:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1230:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return val;
1231:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
