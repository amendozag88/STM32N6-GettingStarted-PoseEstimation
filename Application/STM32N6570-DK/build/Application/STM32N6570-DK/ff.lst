1006:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (acc >= 1 && Files[i].ctr) return 0;	/* Access violation (int err) */
1007:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1008:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	Files[i].ctr = acc ? 0x100 : Files[i].ctr + 1;	/* Set semaphore value */
1009:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1010:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return i + 1;	/* Index number origin from 1 */
1011:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
