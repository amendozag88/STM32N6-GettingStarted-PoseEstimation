 692:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* Test if the byte is DBC 1st byte */
 693:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static int dbc_1st (BYTE c)
 694:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
 695:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if FF_CODE_PAGE == 0		/* Variable code page */
 696:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (DbcTbl && c >= DbcTbl[0]) {
 697:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (c <= DbcTbl[1]) return 1;					/* 1st byte range 1 */
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccTbTRBb.s 			page 15


 698:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (c >= DbcTbl[2] && c <= DbcTbl[3]) return 1;	/* 1st byte range 2 */
 699:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
 700:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #elif FF_CODE_PAGE >= 900	/* DBCS fixed code page */
 701:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (c >= DbcTbl[0]) {
 702:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (c <= DbcTbl[1]) return 1;
 703:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (c >= DbcTbl[2] && c <= DbcTbl[3]) return 1;
 704:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
 705:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #else						/* SBCS fixed code page */
 706:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (c != 0) return 0;	/* Always false */
 707:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
 708:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return 0;
 709:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
 710:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
