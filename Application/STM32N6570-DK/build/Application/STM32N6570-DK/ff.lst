3253:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		bcc = crc32(bcc, i - GPTH_Bcc < 4 ? 0 : gpth[i]);
3254:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
3255:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (~bcc != ld_dword(gpth + GPTH_Bcc)) return 0;
3256:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (ld_dword(gpth + GPTH_PteSize) != SZ_GPTE) return 0;	/* Table entry size (must be SZ_GPTE bytes
3257:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (ld_dword(gpth + GPTH_PtNum) > 128) return 0;		/* Table size (must be 128 entries or less) */
3258:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3259:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return 1;
3260:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
