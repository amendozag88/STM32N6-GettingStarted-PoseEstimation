1475:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				res = change_bitmap(fs, scl, ecl - scl + 1, 0);	/* Mark the cluster block 'free' on the bitmap 
1476:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (res != FR_OK) return res;
1477:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			}
1478:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
1479:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if FF_USE_TRIM
1480:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			rt[0] = clst2sect(fs, scl);					/* Start of data area to be freed */
1481:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			rt[1] = clst2sect(fs, ecl) + fs->csize - 1;	/* End of data area to be freed */
1482:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			disk_ioctl(fs->pdrv, CTRL_TRIM, rt);		/* Inform storage device that the data in the block may be
1483:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
1484:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			scl = ecl = nxt;
1485:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1486:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
1487:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		clst = nxt;					/* Next cluster */
1488:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	} while (clst < fs->n_fatent);	/* Repeat while not the last link */
1489:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
