1635:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD *tbl;
1636:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FATFS *fs = fp->obj.fs;
1637:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1638:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1639:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	tbl = fp->cltbl + 1;	/* Top of CLMT */
1640:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	cl = (DWORD)(ofs / SS(fs) / fs->csize);	/* Cluster order from top of the file */
1641:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	for (;;) {
1642:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		ncl = *tbl++;			/* Number of cluters in the fragment */
1643:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (ncl == 0) return 0;	/* End of table? (error) */
1644:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (cl < ncl) break;	/* In this fragment? */
1645:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		cl -= ncl; tbl++;		/* Next fragment */
1646:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
1647:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return cl + *tbl;	/* Return the cluster number */
1648:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
