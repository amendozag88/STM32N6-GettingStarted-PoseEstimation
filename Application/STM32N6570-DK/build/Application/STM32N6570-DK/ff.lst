1896:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (ld_word(dir + LDIR_FstClusLO) != 0) return 0;	/* Check LDIR_FstClusLO */
1897:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1898:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	i = ((dir[LDIR_Ord] & 0x3F) - 1) * 13;	/* Offset in the LFN buffer */
