1749:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	int stretch				/* 0: Do not stretch table, 1: Stretch table if needed */
1750:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
1751:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
1752:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD ofs, clst;
1753:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FATFS *fs = dp->obj.fs;
1754:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1755:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1756:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	ofs = dp->dptr + SZDIRE;	/* Next entry */
1757:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (ofs >= (DWORD)((FF_FS_EXFAT && fs->fs_type == FS_EXFAT) ? MAX_DIR_EX : MAX_DIR)) dp->sect = 0;
1758:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (dp->sect == 0) return FR_NO_FILE;	/* Report EOT if it has been disabled */
1759:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1760:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (ofs % SS(fs) == 0) {	/* Sector changed? */
1761:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		dp->sect++;				/* Next sector */
1762:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1763:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (dp->clust == 0) {	/* Static table */
1764:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (ofs / SZDIRE >= fs->n_rootdir) {	/* Report EOT if it reached end of static table */
1765:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				dp->sect = 0; return FR_NO_FILE;
1766:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			}
1767:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1768:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		else {					/* Dynamic table */
1769:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if ((ofs / SS(fs) & (fs->csize - 1)) == 0) {	/* Cluster changed? */
1770:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				clst = get_fat(&dp->obj, dp->clust);		/* Get next cluster */
1771:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (clst <= 1) return FR_INT_ERR;			/* Internal error */
1772:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (clst == 0xFFFFFFFF) return FR_DISK_ERR;	/* Disk error */
1773:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (clst >= fs->n_fatent) {					/* It reached end of dynamic table */
1774:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if !FF_FS_READONLY
1775:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					if (!stretch) {								/* If no stretch, report EOT */
1776:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 						dp->sect = 0; return FR_NO_FILE;
1777:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					}
1778:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					clst = create_chain(&dp->obj, dp->clust);	/* Allocate a cluster */
1779:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					if (clst == 0) return FR_DENIED;			/* No free cluster */
1780:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					if (clst == 1) return FR_INT_ERR;			/* Internal error */
1781:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					if (clst == 0xFFFFFFFF) return FR_DISK_ERR;	/* Disk error */
1782:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					if (dir_clear(fs, clst) != FR_OK) return FR_DISK_ERR;	/* Clean up the stretched table */
1783:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					if (FF_FS_EXFAT) dp->obj.stat |= 4;			/* exFAT: The directory has been stretched */
1784:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #else
1785:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					if (!stretch) dp->sect = 0;					/* (this line is to suppress compiler warning) */
1786:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					dp->sect = 0; return FR_NO_FILE;			/* Report EOT */
1787:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
1788:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				}
1789:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				dp->clust = clst;		/* Initialize data for new cluster */
1790:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				dp->sect = clst2sect(fs, clst);
1791:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			}
1792:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1793:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
1794:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	dp->dptr = ofs;						/* Current entry */
