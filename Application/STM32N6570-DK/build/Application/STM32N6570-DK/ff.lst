1394:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1395:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		obj->stat = 0;	/* Change status 'FAT chain is valid' */
