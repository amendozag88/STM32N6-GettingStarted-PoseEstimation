2800:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
2801:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
2802:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	const TCHAR *pptr;
