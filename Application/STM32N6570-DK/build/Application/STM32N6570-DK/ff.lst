 992:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (Files[i].fs == dp->obj.fs
 993:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		 && Files[i].clu == dp->obj.sclust
