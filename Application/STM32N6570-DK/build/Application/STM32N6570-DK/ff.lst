2862:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2863:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Create LFN into LFN working buffer */
2864:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	p = *path; lfn = dp->obj.fs->lfnbuf; di = 0;
2865:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	for (;;) {
2866:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		uc = tchar2uni(&p);			/* Get a character */
2867:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (uc == 0xFFFFFFFF) return FR_INVALID_NAME;		/* Invalid code or UTF decode error */
2868:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (uc >= 0x10000) lfn[di++] = (WCHAR)(uc >> 16);	/* Store high surrogate if needed */
2869:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		wc = (WCHAR)uc;
2870:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (wc < ' ' || IsSeparator(wc)) break;	/* Break if end of the path or a separator is found */
2871:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (wc < 0x80 && strchr("*:<>|\"\?\x7F", (int)wc)) return FR_INVALID_NAME;	/* Reject illegal char
2872:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (di >= FF_MAX_LFN) return FR_INVALID_NAME;	/* Reject too long name */
2873:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		lfn[di++] = wc;				/* Store the Unicode character */
2874:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
2875:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (wc < ' ') {				/* Stopped at end of the path? */
2876:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		cf = NS_LAST;			/* Last segment */
2877:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	} else {					/* Stopped at a separator */
2878:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		while (IsSeparator(*p)) p++;	/* Skip duplicated separators if exist */
