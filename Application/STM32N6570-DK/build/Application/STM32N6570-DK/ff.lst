  66:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define AM_LFN		0x0F	/* LFN entry */
  67:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define AM_MASK		0x3F	/* Mask of defined bits in FAT */
  68:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define AM_MASKX	0x37	/* Mask of defined bits in exFAT */
