 716:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (DbcTbl && c >= DbcTbl[4]) {
 717:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (c <= DbcTbl[5]) return 1;					/* 2nd byte range 1 */
 718:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (c >= DbcTbl[6] && c <= DbcTbl[7]) return 1;	/* 2nd byte range 2 */
 719:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (c >= DbcTbl[8] && c <= DbcTbl[9]) return 1;	/* 2nd byte range 3 */
