2898:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		di--;
2899:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
2900:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	lfn[di] = 0;							/* LFN is created into the working buffer */
2901:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (di == 0) return FR_INVALID_NAME;	/* Reject null name */
2902:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2903:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Create SFN in directory form */
2904:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	for (si = 0; lfn[si] == ' '; si++) ;	/* Remove leading spaces */
2905:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (si > 0 || lfn[si] == '.') cf |= NS_LOSS | NS_LFN;	/* Is there any leading space or dot? */
2906:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	while (di > 0 && lfn[di - 1] != '.') di--;	/* Find last dot (di<=si: no extension) */
