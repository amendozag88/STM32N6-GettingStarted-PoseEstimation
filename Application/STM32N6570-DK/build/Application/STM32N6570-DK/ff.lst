2893:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
2894:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
2895:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	while (di) {					/* Snip off trailing spaces and dots if exist */
2896:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		wc = lfn[di - 1];
