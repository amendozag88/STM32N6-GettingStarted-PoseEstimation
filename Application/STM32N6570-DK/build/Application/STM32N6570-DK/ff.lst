2180:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* exFAT: Initialize object allocation info with loaded entry block */
2181:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*------------------------------------------------------------------*/
2182:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2183:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static void init_alloc_info (
2184:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FATFS* fs,		/* Filesystem object */
2185:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FFOBJID* obj	/* Object allocation information to be initialized */
2186:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
2187:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
2188:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	obj->sclust = ld_dword(fs->dirbuf + XDIR_FstClus);		/* Start cluster */
2189:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	obj->objsize = ld_qword(fs->dirbuf + XDIR_FileSize);	/* Size */
2190:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	obj->stat = fs->dirbuf[XDIR_GenFlags] & 2;				/* Allocation status */
2191:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	obj->n_frag = 0;										/* No last fragment info */
2192:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
