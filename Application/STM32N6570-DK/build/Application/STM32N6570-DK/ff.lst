1823:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (res != FR_OK) break;
1824:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if FF_FS_EXFAT
1825:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if ((fs->fs_type == FS_EXFAT) ? (int)((dp->dir[XDIR_Type] & 0x80) == 0) : (int)(dp->dir[DIR_Name
1826:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #else
1827:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (dp->dir[DIR_Name] == DDEM || dp->dir[DIR_Name] == 0) {	/* Is the entry free? */
1828:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
1829:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (++n == n_ent) break;	/* Is a block of contiguous free entries found? */
1830:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			} else {
1831:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				n = 0;				/* Not a free entry, restart to search */
1832:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			}
1833:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			res = dir_next(dp, 1);	/* Next entry with table stretch enabled */
1834:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		} while (res == FR_OK);
1835:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
1836:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1837:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (res == FR_NO_FILE) res = FR_DENIED;	/* No directory entry to allocate */
1838:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return res;
1839:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
