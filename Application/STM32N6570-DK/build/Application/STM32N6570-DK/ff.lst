 799:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
 800:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	*str = p;	/* Next read pointer */
