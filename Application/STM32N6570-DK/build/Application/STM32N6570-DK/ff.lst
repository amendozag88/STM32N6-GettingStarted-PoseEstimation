2890:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
2891:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		dp->fn[i] = cf | NS_DOT;	/* This is a dot entry */
