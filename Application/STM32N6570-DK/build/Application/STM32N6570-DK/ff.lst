2129:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* exFAT: Get a directory entry block */
2130:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*------------------------------------*/
2131:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2132:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static FRESULT load_xdir (	/* FR_INT_ERR: invalid entry block */
2133:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DIR* dp					/* Reading directory object pointing top of the entry block to load */
2134:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
2135:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
2136:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FRESULT res;
2137:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT i, sz_ent;
2138:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE *dirb = dp->obj.fs->dirbuf;	/* Pointer to the on-memory directory entry block 85+C0+C1s */
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccTbTRBb.s 			page 41


2139:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2140:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2141:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Load file directory entry */
2142:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	res = move_window(dp->obj.fs, dp->sect);
2143:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (res != FR_OK) return res;
2144:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (dp->dir[XDIR_Type] != ET_FILEDIR) return FR_INT_ERR;	/* Invalid order */
2145:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	memcpy(dirb + 0 * SZDIRE, dp->dir, SZDIRE);
2146:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	sz_ent = (dirb[XDIR_NumSec] + 1) * SZDIRE;
2147:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (sz_ent < 3 * SZDIRE || sz_ent > 19 * SZDIRE) return FR_INT_ERR;
2148:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2149:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Load stream extension entry */
2150:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	res = dir_next(dp, 0);
2151:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (res == FR_NO_FILE) res = FR_INT_ERR;	/* It cannot be */
2152:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (res != FR_OK) return res;
2153:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	res = move_window(dp->obj.fs, dp->sect);
2154:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (res != FR_OK) return res;
2155:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (dp->dir[XDIR_Type] != ET_STREAM) return FR_INT_ERR;	/* Invalid order */
2156:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	memcpy(dirb + 1 * SZDIRE, dp->dir, SZDIRE);
2157:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (MAXDIRB(dirb[XDIR_NumName]) > sz_ent) return FR_INT_ERR;
2158:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2159:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Load file name entries */
2160:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	i = 2 * SZDIRE;	/* Name offset to load */
2161:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	do {
2162:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		res = dir_next(dp, 0);
2163:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (res == FR_NO_FILE) res = FR_INT_ERR;	/* It cannot be */
2164:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (res != FR_OK) return res;
2165:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		res = move_window(dp->obj.fs, dp->sect);
2166:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (res != FR_OK) return res;
2167:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (dp->dir[XDIR_Type] != ET_FILENAME) return FR_INT_ERR;	/* Invalid order */
2168:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (i < MAXDIRB(FF_MAX_LFN)) memcpy(dirb + i, dp->dir, SZDIRE);
2169:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	} while ((i += SZDIRE) < sz_ent);
2170:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2171:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Sanity check (do it for only accessible object) */
2172:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (i <= MAXDIRB(FF_MAX_LFN)) {
2173:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (xdir_sum(dirb) != ld_word(dirb + XDIR_SetSum)) return FR_INT_ERR;
2174:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
2175:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return FR_OK;
2176:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
2177:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
