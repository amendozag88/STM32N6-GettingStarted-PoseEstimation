  38:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* Limits and boundaries */
  39:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define MAX_DIR		0x200000		/* Max size of FAT directory */
  40:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define MAX_DIR_EX	0x10000000		/* Max size of exFAT directory */
  41:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define MAX_FAT12	0xFF5			/* Max FAT12 clusters (differs from specs, but right for real DOS/Windows
  42:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define MAX_FAT16	0xFFF5			/* Max FAT16 clusters (differs from specs, but right for real DOS/Window
  43:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define MAX_FAT32	0x0FFFFFF5		/* Max FAT32 clusters (not specified, practical limit) */
  44:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #define MAX_EXFAT	0x7FFFFFFD		/* Max exFAT clusters (differs from specs, implementation limit) */
