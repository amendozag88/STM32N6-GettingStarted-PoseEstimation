2052:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* FAT-LFN: Calculate checksum of an SFN entry                           */
2053:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*-----------------------------------------------------------------------*/
2054:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2055:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static BYTE sum_sfn (
2056:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	const BYTE* dir		/* Pointer to the SFN entry */
2057:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
2058:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
2059:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE sum = 0;
2060:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT n = 11;
