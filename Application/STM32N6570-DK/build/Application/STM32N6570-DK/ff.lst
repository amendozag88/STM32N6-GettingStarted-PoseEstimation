1494:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			obj->stat = 0;		/* Change the chain status 'initial' */
1495:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		} else {
1496:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (obj->stat == 0) {	/* Is it a fragmented chain from the beginning of this session? */
1497:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				clst = obj->sclust;		/* Follow the chain to check if it gets contiguous */
1498:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				while (clst != pclst) {
1499:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					nxt = get_fat(obj, clst);
