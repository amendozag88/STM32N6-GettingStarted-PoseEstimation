1573:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	} else
1574:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
1575:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	{	/* On the FAT/FAT32 volume */
1576:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		ncl = 0;
1577:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (scl == clst) {						/* Stretching an existing chain? */
1578:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			ncl = scl + 1;						/* Test if next cluster is free */
1579:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (ncl >= fs->n_fatent) ncl = 2;
1580:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			cs = get_fat(obj, ncl);				/* Get next cluster status */
1581:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (cs == 1 || cs == 0xFFFFFFFF) return cs;	/* Test for error */
1582:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (cs != 0) {						/* Not free? */
1583:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				cs = fs->last_clst;				/* Start at suggested cluster if it is valid */
1584:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (cs >= 2 && cs < fs->n_fatent) scl = cs;
1585:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				ncl = 0;
1586:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			}
1587:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1588:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (ncl == 0) {	/* The new cluster cannot be contiguous and find another fragment */
1589:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			ncl = scl;	/* Start cluster */
1590:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			for (;;) {
1591:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				ncl++;							/* Next cluster */
1592:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (ncl >= fs->n_fatent) {		/* Check wrap-around */
1593:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					ncl = 2;
1594:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					if (ncl > scl) return 0;	/* No free cluster found? */
1595:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				}
1596:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				cs = get_fat(obj, ncl);			/* Get the cluster status */
1597:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (cs == 0) break;				/* Found a free cluster? */
1598:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (cs == 1 || cs == 0xFFFFFFFF) return cs;	/* Test for error */
1599:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (ncl == scl) return 0;		/* No free cluster found? */
1600:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			}
1601:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1602:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		res = put_fat(fs, ncl, 0xFFFFFFFF);		/* Mark the new cluster 'EOC' */
1603:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (res == FR_OK && clst != 0) {
1604:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			res = put_fat(fs, clst, ncl);		/* Link it from the previous one if needed */
1605:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1606:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
1607:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1608:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (res == FR_OK) {			/* Update FSINFO if function succeeded. */
1609:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		fs->last_clst = ncl;
1610:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (fs->free_clst <= fs->n_fatent - 2) fs->free_clst--;
1611:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		fs->fsi_flag |= 1;
1612:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	} else {
1613:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		ncl = (res == FR_DISK_ERR) ? 0xFFFFFFFF : 1;	/* Failed. Generate error status */
