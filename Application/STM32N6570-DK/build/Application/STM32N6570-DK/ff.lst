2914:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			cf |= NS_LOSS | NS_LFN;
2915:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			continue;
2916:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
2917:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2918:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (i >= ni || si == di) {		/* End of field? */
2919:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (ni == 11) {				/* Name extension overflow? */
2920:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				cf |= NS_LOSS | NS_LFN;
2921:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				break;
2922:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			}
2923:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (si != di) cf |= NS_LOSS | NS_LFN;	/* Name body overflow? */
