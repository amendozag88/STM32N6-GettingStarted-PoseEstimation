2885:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if ((di == 1 && lfn[di - 1] == '.') ||
2886:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		(di == 2 && lfn[di - 1] == '.' && lfn[di - 2] == '.')) {	/* Is this segment a dot name? */
