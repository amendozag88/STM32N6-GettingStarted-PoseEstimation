1299:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* exFAT: Accessing FAT and Allocation Bitmap                            */
1300:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*-----------------------------------------------------------------------*/
1301:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1302:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*--------------------------------------*/
1303:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* Find a contiguous free cluster block */
1304:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*--------------------------------------*/
1305:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1306:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static DWORD find_bitmap (	/* 0:Not found, 2..:Cluster block found, 0xFFFFFFFF:Disk error */
1307:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FATFS* fs,	/* Filesystem object */
1308:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD clst,	/* Cluster number to scan from */
1309:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD ncl	/* Number of contiguous clusters to find (1..) */
1310:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
1311:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
1312:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE bm, bv;
1313:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT i;
1314:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD val, scl, ctr;
1315:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1316:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1317:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	clst -= 2;	/* The first bit in the bitmap corresponds to cluster #2 */
1318:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (clst >= fs->n_fatent - 2) clst = 0;
1319:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	scl = val = clst; ctr = 0;
1320:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	for (;;) {
1321:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (move_window(fs, fs->bitbase + val / 8 / SS(fs)) != FR_OK) return 0xFFFFFFFF;
1322:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		i = val / 8 % SS(fs); bm = 1 << (val % 8);
1323:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		do {
1324:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			do {
1325:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				bv = fs->win[i] & bm; bm <<= 1;		/* Get bit value */
1326:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (++val >= fs->n_fatent - 2) {	/* Next cluster (with wrap-around) */
1327:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					val = 0; bm = 0; i = SS(fs);
1328:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				}
1329:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (bv == 0) {	/* Is it a free cluster? */
1330:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					if (++ctr == ncl) return scl + 2;	/* Check if run length is sufficient for required */
1331:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				} else {
1332:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					scl = val; ctr = 0;		/* Encountered a cluster in-use, restart to scan */
1333:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				}
1334:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (val == clst) return 0;	/* All cluster scanned? */
1335:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			} while (bm != 0);
1336:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			bm = 1;
1337:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		} while (++i < SS(fs));
1338:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
1339:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
1340:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccTbTRBb.s 			page 27


1341:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1342:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*----------------------------------------*/
1343:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* Set/Clear a block of allocation bitmap */
1344:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*----------------------------------------*/
1345:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1346:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static FRESULT change_bitmap (
1347:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FATFS* fs,	/* Filesystem object */
1348:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD clst,	/* Cluster number to change from */
1349:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD ncl,	/* Number of clusters to be changed */
1350:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	int bv		/* bit value to be set (0 or 1) */
1351:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
1352:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
1353:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE bm;
1354:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT i;
1355:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	LBA_t sect;
1356:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1357:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1358:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	clst -= 2;	/* The first bit corresponds to cluster #2 */
1359:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	sect = fs->bitbase + clst / 8 / SS(fs);	/* Sector address */
1360:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	i = clst / 8 % SS(fs);					/* Byte offset in the sector */
1361:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	bm = 1 << (clst % 8);					/* Bit mask in the byte */
1362:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	for (;;) {
1363:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (move_window(fs, sect++) != FR_OK) return FR_DISK_ERR;
1364:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		do {
1365:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			do {
1366:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (bv == (int)((fs->win[i] & bm) != 0)) return FR_INT_ERR;	/* Is the bit expected value? */
1367:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				fs->win[i] ^= bm;	/* Flip the bit */
1368:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				fs->wflag = 1;
1369:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (--ncl == 0) return FR_OK;	/* All bits processed? */
1370:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			} while (bm <<= 1);		/* Next bit */
1371:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			bm = 1;
1372:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		} while (++i < SS(fs));		/* Next byte */
1373:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		i = 0;
1374:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
1375:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
1376:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1377:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1378:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*---------------------------------------------*/
1379:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* Fill the first fragment of the FAT chain    */
1380:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*---------------------------------------------*/
1381:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1382:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static FRESULT fill_first_frag (
1383:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FFOBJID* obj	/* Pointer to the corresponding object */
1384:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
1385:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
1386:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FRESULT res;
1387:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD cl, n;
1388:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1389:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1390:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (obj->stat == 3) {	/* Has the object been changed 'fragmented' in this session? */
1391:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		for (cl = obj->sclust, n = obj->n_cont; n; cl++, n--) {	/* Create cluster chain on the FAT */
