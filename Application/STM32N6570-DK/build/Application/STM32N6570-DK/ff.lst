1523:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* FAT handling - Stretch a chain or Create a new chain                  */
1524:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*-----------------------------------------------------------------------*/
1525:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1526:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static DWORD create_chain (	/* 0:No free cluster, 1:Internal error, 0xFFFFFFFF:Disk error, >=2:New 
1527:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FFOBJID* obj,		/* Corresponding object */
1528:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD clst			/* Cluster# to stretch, 0:Create a new chain */
1529:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
1530:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
1531:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD cs, ncl, scl;
1532:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FRESULT res;
1533:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FATFS *fs = obj->fs;
1534:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1535:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1536:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (clst == 0) {	/* Create a new chain */
1537:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		scl = fs->last_clst;				/* Suggested cluster to start to find */
1538:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (scl == 0 || scl >= fs->n_fatent) scl = 1;
1539:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
1540:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	else {				/* Stretch a chain */
1541:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		cs = get_fat(obj, clst);			/* Check the cluster status */
1542:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (cs < 2) return 1;				/* Test for insanity */
1543:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (cs == 0xFFFFFFFF) return cs;	/* Test for disk error */
1544:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (cs < fs->n_fatent) return cs;	/* It is already followed by next cluster */
1545:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		scl = clst;							/* Cluster to start to find */
1546:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
1547:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (fs->free_clst == 0) return 0;		/* No free cluster */
1548:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1549:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if FF_FS_EXFAT
1550:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (fs->fs_type == FS_EXFAT) {	/* On the exFAT volume */
1551:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		ncl = find_bitmap(fs, scl, 1);				/* Find a free cluster */
1552:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (ncl == 0 || ncl == 0xFFFFFFFF) return ncl;	/* No free cluster or hard error? */
1553:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		res = change_bitmap(fs, ncl, 1, 1);			/* Mark the cluster 'in use' */
1554:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (res == FR_INT_ERR) return 1;
1555:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (res == FR_DISK_ERR) return 0xFFFFFFFF;
1556:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (clst == 0) {							/* Is it a new chain? */
1557:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			obj->stat = 2;							/* Set status 'contiguous' */
1558:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		} else {									/* It is a stretched chain */
1559:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (obj->stat == 2 && ncl != scl + 1) {	/* Is the chain got fragmented? */
1560:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				obj->n_cont = scl - obj->sclust;	/* Set size of the contiguous part */
1561:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				obj->stat = 3;						/* Change status 'just fragmented' */
1562:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			}
1563:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1564:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (obj->stat != 2) {	/* Is the file non-contiguous? */
1565:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (ncl == clst + 1) {	/* Is the cluster next to previous one? */
1566:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				obj->n_frag = obj->n_frag ? obj->n_frag + 1 : 2;	/* Increment size of last framgent */
1567:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			} else {				/* New fragment */
1568:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (obj->n_frag == 0) obj->n_frag = 1;
