1235:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1236:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if !FF_FS_READONLY
1237:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*-----------------------------------------------------------------------*/
1238:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* FAT access - Change value of an FAT entry                             */
1239:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*-----------------------------------------------------------------------*/
1240:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1241:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static FRESULT put_fat (	/* FR_OK(0):succeeded, !=0:error */
1242:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FATFS* fs,		/* Corresponding filesystem object */
1243:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD clst,		/* FAT index number (cluster number) to be changed */
1244:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD val		/* New value to be set to the entry */
1245:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
1246:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
1247:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT bc;
1248:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE *p;
1249:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FRESULT res = FR_INT_ERR;
1250:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1251:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1252:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (clst >= 2 && clst < fs->n_fatent) {	/* Check if in valid range */
1253:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		switch (fs->fs_type) {
1254:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		case FS_FAT12:
1255:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			bc = (UINT)clst; bc += bc / 2;	/* bc: byte offset of the entry */
1256:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			res = move_window(fs, fs->fatbase + (bc / SS(fs)));
1257:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (res != FR_OK) break;
1258:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			p = fs->win + bc++ % SS(fs);
1259:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			*p = (clst & 1) ? ((*p & 0x0F) | ((BYTE)val << 4)) : (BYTE)val;	/* Update 1st byte */
1260:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			fs->wflag = 1;
1261:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			res = move_window(fs, fs->fatbase + (bc / SS(fs)));
1262:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (res != FR_OK) break;
1263:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			p = fs->win + bc % SS(fs);
1264:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			*p = (clst & 1) ? (BYTE)(val >> 4) : ((*p & 0xF0) | ((BYTE)(val >> 8) & 0x0F));	/* Update 2nd by
1265:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			fs->wflag = 1;
1266:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			break;
1267:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1268:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		case FS_FAT16:
1269:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			res = move_window(fs, fs->fatbase + (clst / (SS(fs) / 2)));
1270:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (res != FR_OK) break;
1271:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			st_word(fs->win + clst * 2 % SS(fs), (WORD)val);	/* Simple WORD array */
1272:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			fs->wflag = 1;
1273:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			break;
1274:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1275:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		case FS_FAT32:
1276:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if FF_FS_EXFAT
1277:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		case FS_EXFAT:
1278:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
1279:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			res = move_window(fs, fs->fatbase + (clst / (SS(fs) / 4)));
1280:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (res != FR_OK) break;
1281:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			if (!FF_FS_EXFAT || fs->fs_type != FS_EXFAT) {
1282:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				val = (val & 0x0FFFFFFF) | (ld_dword(fs->win + clst * 4 % SS(fs)) & 0xF0000000);
1283:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			}
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccTbTRBb.s 			page 26


1284:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			st_dword(fs->win + clst * 4 % SS(fs), val);
1285:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			fs->wflag = 1;
1286:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 			break;
1287:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		}
1288:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
1289:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return res;
1290:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
