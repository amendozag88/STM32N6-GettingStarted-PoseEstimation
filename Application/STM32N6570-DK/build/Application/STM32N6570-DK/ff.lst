2032:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	} while (i && seq);
2033:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	ns[i] = '~';
