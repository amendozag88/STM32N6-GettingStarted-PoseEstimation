1631:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FSIZE_t ofs		/* File offset to be converted to cluster# */
1632:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
1633:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
