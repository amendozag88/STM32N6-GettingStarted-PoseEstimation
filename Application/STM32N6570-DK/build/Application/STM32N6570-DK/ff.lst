1491:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Some post processes for chain status */
1492:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (fs->fs_type == FS_EXFAT) {
