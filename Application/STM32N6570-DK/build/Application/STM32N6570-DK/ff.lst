 795:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (wc == 0) return 0xFFFFFFFF;	/* Invalid code? */
 796:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
 797:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	uc = wc;
