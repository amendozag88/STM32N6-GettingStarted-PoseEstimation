 969:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* The object was opened. Reject any open against writing file and all write mode open */
 970:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return (acc != 0 || Files[i].ctr == 0x100) ? FR_LOCKED : FR_OK;
 971:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
 972:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
