3240:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3241:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static int test_gpt_header (	/* 0:Invalid, 1:Valid */
3242:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	const BYTE* gpth			/* Pointer to the GPT header */
3243:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
3244:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
3245:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	UINT i;
3246:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD bcc, hlen;
3247:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3248:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3249:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (memcmp(gpth + GPTH_Sign, "EFI PART" "\0\0\1", 12)) return 0;	/* Check signature and version (1
3250:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	hlen = ld_dword(gpth + GPTH_Size);						/* Check header size */
3251:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (hlen < 92 || hlen > FF_MIN_SS) return 0;
3252:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	for (i = 0, bcc = 0xFFFFFFFF; i < hlen; i++) {			/* Check header BCC */
