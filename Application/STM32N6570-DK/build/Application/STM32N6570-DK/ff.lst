2198:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* exFAT: Load the object's directory entry block */
2199:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*------------------------------------------------*/
2200:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2201:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static FRESULT load_obj_xdir (
2202:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DIR* dp,			/* Blank directory object to be used to access containing directory */
2203:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	const FFOBJID* obj	/* Object with its containing directory information */
2204:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
2205:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
2206:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	FRESULT res;
2207:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2208:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Open object containing directory */
2209:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	dp->obj.fs = obj->fs;
2210:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	dp->obj.sclust = obj->c_scl;
2211:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	dp->obj.stat = (BYTE)obj->c_size;
2212:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	dp->obj.objsize = obj->c_size & 0xFFFFFF00;
2213:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	dp->obj.n_frag = 0;
2214:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	dp->blk_ofs = obj->c_ofs;
2215:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2216:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	res = dir_sdi(dp, dp->blk_ofs);	/* Goto object's entry block */
2217:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (res == FR_OK) {
2218:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		res = load_xdir(dp);		/* Load the object's entry block */
2219:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
2220:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return res;
2221:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
2222:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
2223:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
