2846:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* Pick a top segment and create the object name in directory form       */
2847:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /*-----------------------------------------------------------------------*/
2848:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2849:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static FRESULT create_name (	/* FR_OK: successful, FR_INVALID_NAME: could not create */
2850:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DIR* dp,					/* Pointer to the directory object */
2851:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	const TCHAR** path			/* Pointer to pointer to the segment in the path string */
2852:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
2853:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
2854:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #if FF_USE_LFN		/* LFN configuration */
2855:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE b, cf;
2856:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	WCHAR wc;
