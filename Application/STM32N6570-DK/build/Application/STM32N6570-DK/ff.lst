 863:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (szb < 1) return 0;	/* Buffer overflow? */
 864:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (chr >= 0x10000) {	/* Out of BMP? */
 865:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		hc = ((chr & 0xFFFF0000) - 0xD8000000) >> 6;	/* Get high 10 bits */
 866:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		chr = (chr & 0xFFFF) - 0xDC00;					/* Get low 10 bits */
 867:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		if (hc >= 0x100000 || chr >= 0x400) return 0;	/* Wrong surrogate? */
