 776:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
 777:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
 778:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #elif FF_LFN_UNICODE == 3	/* UTF-32 input */
 779:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	uc = (TCHAR)*p++;	/* Get a unit */
 780:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (uc >= 0x110000 || IsSurrogate(uc)) return 0xFFFFFFFF;	/* Wrong code? */
 781:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (uc >= 0x010000) uc = 0xD800DC00 | ((uc - 0x10000) << 6 & 0x3FF0000) | (uc & 0x3FF);	/* Make a 
 782:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
 783:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #else		/* ANSI/OEM input */
 784:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE b;
 785:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	WCHAR wc;
 786:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
 787:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	wc = (BYTE)*p++;			/* Get a byte */
 788:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (dbc_1st((BYTE)wc)) {	/* Is it a DBC 1st byte? */
