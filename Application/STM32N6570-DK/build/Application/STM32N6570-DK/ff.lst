1444:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	LBA_t rt[2];
1445:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** #endif
1446:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1447:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (clst < 2 || clst >= fs->n_fatent) return FR_INT_ERR;	/* Check if in valid range */
1448:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
1449:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	/* Mark the previous cluster 'EOC' on the FAT if it exists */
1450:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (pclst != 0 && (!FF_FS_EXFAT || fs->fs_type != FS_EXFAT || obj->stat != 2)) {
1451:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		res = put_fat(fs, pclst, 0xFFFFFFFF);
