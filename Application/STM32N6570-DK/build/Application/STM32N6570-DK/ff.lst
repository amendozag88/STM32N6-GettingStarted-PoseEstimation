1505:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				if (clst == pclst) {	/* Has the chain got contiguous again? */
1506:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 					obj->stat = 2;		/* Change the chain status 'contiguous' */
1507:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 				}
