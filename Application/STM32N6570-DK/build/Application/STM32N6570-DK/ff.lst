2908:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	memset(dp->fn, ' ', 11);
2909:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	i = b = 0; ni = 8;
