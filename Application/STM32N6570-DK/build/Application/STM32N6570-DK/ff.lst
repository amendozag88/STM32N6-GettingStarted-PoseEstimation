3221:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** /* Calculate CRC32 in byte-by-byte */
3222:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3223:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** static DWORD crc32 (	/* Returns next CRC value */
3224:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	DWORD crc,			/* Current CRC value */
3225:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE d				/* A byte to be processed */
3226:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** )
3227:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** {
3228:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	BYTE b;
3229:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3230:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
3231:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	for (b = 1; b; b <<= 1) {
3232:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		crc ^= (d & b) ? 1 : 0;
3233:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		crc = (crc & 1) ? crc >> 1 ^ 0xEDB88320 : crc >> 1;
3234:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	}
3235:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	return crc;
3236:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** }
