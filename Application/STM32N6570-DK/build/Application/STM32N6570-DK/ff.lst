2012:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 
2013:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 	if (seq > 5) {	/* In case of many collisions, generate a hash number instead of sequential number 
2014:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		sreg = seq;
2015:../../STM32Cube_FW_N6/Middlewares/Third_Party_fs/source/ff.c **** 		while (*lfn) {	/* Create a CRC as hash value */
