 106:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_ll_sdmmc.c ****            (++) Data TimeOut
 107:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_ll_sdmmc.c ****            (++) Data Length
 108:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_ll_sdmmc.c ****            (++) Data Block size
 109:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_ll_sdmmc.c ****            (++) Data Transfer direction: should be from card (To SDMMC)
 110:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_ll_sdmmc.c ****            (++) Data Transfer mode
 111:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_ll_sdmmc.c ****            (++) DPSM Status (Enable or Disable)
