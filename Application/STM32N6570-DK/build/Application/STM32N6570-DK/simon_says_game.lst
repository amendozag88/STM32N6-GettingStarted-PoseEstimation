  35:Src/simon_says_game.c **** static int PoseMatched(SimonPose_t pose, spe_pp_outBuffer_t *k)
  36:Src/simon_says_game.c **** {
  37:Src/simon_says_game.c ****     float32_t lx = k[KEYPOINT_LEFT_WRIST].x_center;
  38:Src/simon_says_game.c ****     float32_t ly = k[KEYPOINT_LEFT_WRIST].y_center;
  39:Src/simon_says_game.c ****     float32_t rx = k[KEYPOINT_RIGHT_WRIST].x_center;
  40:Src/simon_says_game.c ****     float32_t ry = k[KEYPOINT_RIGHT_WRIST].y_center;
  41:Src/simon_says_game.c ****     switch(pose)
  42:Src/simon_says_game.c ****     {
  43:Src/simon_says_game.c ****     case POSE_HANDS_UP:
  44:Src/simon_says_game.c ****         return (ly < k[KEYPOINT_LEFT_SHOULDER].y_center &&
  45:Src/simon_says_game.c ****                 ry < k[KEYPOINT_RIGHT_SHOULDER].y_center);
  46:Src/simon_says_game.c ****     case POSE_HANDS_ON_HEAD:
  47:Src/simon_says_game.c ****         return (ly < k[KEYPOINT_NOSE].y_center &&
  48:Src/simon_says_game.c ****                 ry < k[KEYPOINT_NOSE].y_center &&
  49:Src/simon_says_game.c ****                 fabsf(lx - k[KEYPOINT_NOSE].x_center) < 0.15f &&
  50:Src/simon_says_game.c ****                 fabsf(rx - k[KEYPOINT_NOSE].x_center) < 0.15f);
  51:Src/simon_says_game.c ****     case POSE_HANDS_ON_HIPS:
  52:Src/simon_says_game.c ****         return (fabsf(lx - k[KEYPOINT_LEFT_HIP].x_center) < 0.1f &&
  53:Src/simon_says_game.c ****                 fabsf(ly - k[KEYPOINT_LEFT_HIP].y_center) < 0.1f &&
  54:Src/simon_says_game.c ****                 fabsf(rx - k[KEYPOINT_RIGHT_HIP].x_center) < 0.1f &&
  55:Src/simon_says_game.c ****                 fabsf(ry - k[KEYPOINT_RIGHT_HIP].y_center) < 0.1f);
  56:Src/simon_says_game.c ****     case POSE_LEFT_ARM_OUT:
  57:Src/simon_says_game.c ****         return (lx < k[KEYPOINT_LEFT_SHOULDER].x_center - 0.25f &&
  58:Src/simon_says_game.c ****                 fabsf(ly - k[KEYPOINT_LEFT_SHOULDER].y_center) < 0.15f);
  59:Src/simon_says_game.c ****     case POSE_RIGHT_ARM_OUT:
  60:Src/simon_says_game.c ****         return (rx > k[KEYPOINT_RIGHT_SHOULDER].x_center + 0.25f &&
  61:Src/simon_says_game.c ****                 fabsf(ry - k[KEYPOINT_RIGHT_SHOULDER].y_center) < 0.15f);
  62:Src/simon_says_game.c ****     default:
  63:Src/simon_says_game.c ****         return 0;
  64:Src/simon_says_game.c ****     }
  65:Src/simon_says_game.c **** }
  66:Src/simon_says_game.c **** 
  67:Src/simon_says_game.c **** static void Audio_Init(uint32_t sample_rate, uint32_t bits, uint32_t channels)
  68:Src/simon_says_game.c **** {
  69:Src/simon_says_game.c ****     if (audio_ready)
  70:Src/simon_says_game.c ****         return;
  71:Src/simon_says_game.c ****     BSP_AUDIO_Init_t init;
  72:Src/simon_says_game.c ****     init.Device = AUDIO_OUT_DEVICE_HEADPHONE;
  73:Src/simon_says_game.c ****     init.SampleRate = sample_rate;
  74:Src/simon_says_game.c ****     init.BitsPerSample = bits;
  75:Src/simon_says_game.c ****     init.ChannelsNbr = channels;
  76:Src/simon_says_game.c ****     init.Volume = 70;
  77:Src/simon_says_game.c ****     if (BSP_AUDIO_OUT_Init(0, &init) == BSP_ERROR_NONE)
  78:Src/simon_says_game.c ****     {
  79:Src/simon_says_game.c ****         audio_ready = 1;
  80:Src/simon_says_game.c ****     }
  81:Src/simon_says_game.c **** }
