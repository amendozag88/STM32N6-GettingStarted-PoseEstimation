 192:Src/ninja_fruit_game.c ****             fruit->state = FRUIT_STATE_FALLING;
 193:Src/ninja_fruit_game.c ****             fruit->effect = FRUIT_EFFECT_NONE;
 194:Src/ninja_fruit_game.c ****             // Occasionally spawn special fruits with effects
 195:Src/ninja_fruit_game.c ****             if (rand() % 4 == 0) { // ~5% chance
