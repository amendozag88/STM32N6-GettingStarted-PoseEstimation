 349:Src/ninja_fruit_game.c **** 
 350:Src/ninja_fruit_game.c **** static uint8_t LineIntersectsCircle(float32_t x1, float32_t y1, float32_t x2, float32_t y2,
 351:Src/ninja_fruit_game.c ****                                    float32_t cx, float32_t cy, float32_t radius)
 352:Src/ninja_fruit_game.c **** {
 353:Src/ninja_fruit_game.c ****     // Calculate distance from circle center to line segment
 354:Src/ninja_fruit_game.c ****     float32_t dx = x2 - x1;
 355:Src/ninja_fruit_game.c ****     float32_t dy = y2 - y1;
 356:Src/ninja_fruit_game.c ****     float32_t length = sqrtf(dx*dx + dy*dy);
 357:Src/ninja_fruit_game.c **** 
 358:Src/ninja_fruit_game.c ****     if (length < 0.001f) return 0; // Degenerate line
 359:Src/ninja_fruit_game.c **** 
 360:Src/ninja_fruit_game.c ****     // Normalize direction vector
 361:Src/ninja_fruit_game.c ****     dx /= length;
 362:Src/ninja_fruit_game.c ****     dy /= length;
 363:Src/ninja_fruit_game.c **** 
 364:Src/ninja_fruit_game.c ****     // Vector from line start to circle center
 365:Src/ninja_fruit_game.c ****     float32_t fx = cx - x1;
 366:Src/ninja_fruit_game.c ****     float32_t fy = cy - y1;
 367:Src/ninja_fruit_game.c **** 
ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccFL4Qk9.s 			page 8


 368:Src/ninja_fruit_game.c ****     // Project circle center onto line
 369:Src/ninja_fruit_game.c ****     float32_t t = fx * dx + fy * dy;
 370:Src/ninja_fruit_game.c **** 
 371:Src/ninja_fruit_game.c ****     // Clamp to line segment
 372:Src/ninja_fruit_game.c ****     if (t < 0) t = 0;
 373:Src/ninja_fruit_game.c ****     if (t > length) t = length;
 374:Src/ninja_fruit_game.c **** 
 375:Src/ninja_fruit_game.c ****     // Find closest point on line segment
 376:Src/ninja_fruit_game.c ****     float32_t closest_x = x1 + t * dx;
 377:Src/ninja_fruit_game.c ****     float32_t closest_y = y1 + t * dy;
 378:Src/ninja_fruit_game.c **** 
 379:Src/ninja_fruit_game.c ****     // Check distance to circle
 380:Src/ninja_fruit_game.c ****     float32_t dist_sq = (cx - closest_x) * (cx - closest_x) + (cy - closest_y) * (cy - closest_y);
 381:Src/ninja_fruit_game.c **** 
 382:Src/ninja_fruit_game.c ****     return dist_sq <= (radius * radius);
 383:Src/ninja_fruit_game.c **** }
