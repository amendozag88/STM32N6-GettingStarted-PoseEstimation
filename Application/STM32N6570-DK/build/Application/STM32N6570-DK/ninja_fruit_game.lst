 426:Src/ninja_fruit_game.c **** static void RenderFruit(Fruit_t *fruit, uint32_t screen_width, uint32_t screen_height, uint8_t mirr
 427:Src/ninja_fruit_game.c **** {
 428:Src/ninja_fruit_game.c ****     // Convert normalized coordinates to screen coordinates
 429:Src/ninja_fruit_game.c ****     int screen_x = (int)(fruit->x * screen_width);
 430:Src/ninja_fruit_game.c ****     int screen_y = (int)(fruit->y * screen_height);
 431:Src/ninja_fruit_game.c ****     if (mirror) {
 432:Src/ninja_fruit_game.c ****         screen_x = screen_width - screen_x;
 433:Src/ninja_fruit_game.c ****     }
 434:Src/ninja_fruit_game.c **** 
 435:Src/ninja_fruit_game.c ****     uint32_t color = fruit_colors[fruit->type];
 436:Src/ninja_fruit_game.c ****     if (fruit->effect == FRUIT_EFFECT_NOSE_MODE) {
 437:Src/ninja_fruit_game.c ****         color = UTIL_LCD_COLOR_CYAN;
 438:Src/ninja_fruit_game.c ****     } else if (fruit->effect == FRUIT_EFFECT_MIRROR_MODE) {
 439:Src/ninja_fruit_game.c ****         color = UTIL_LCD_COLOR_MAGENTA;
 440:Src/ninja_fruit_game.c ****     }
 441:Src/ninja_fruit_game.c **** 
 442:Src/ninja_fruit_game.c ****     if (fruit->state == FRUIT_STATE_FALLING) {
 443:Src/ninja_fruit_game.c ****         // Draw whole fruit
 444:Src/ninja_fruit_game.c ****         UTIL_LCD_FillCircle(screen_x, screen_y, FRUIT_SIZE/2, color);
 445:Src/ninja_fruit_game.c **** 
 446:Src/ninja_fruit_game.c ****         // Add highlight for 3D effect
 447:Src/ninja_fruit_game.c ****         UTIL_LCD_FillCircle(screen_x - FRUIT_SIZE/6, screen_y - FRUIT_SIZE/6, FRUIT_SIZE/8,
 448:Src/ninja_fruit_game.c ****                            UTIL_LCD_COLOR_WHITE);
 449:Src/ninja_fruit_game.c ****     }
 450:Src/ninja_fruit_game.c ****     else if (fruit->state == FRUIT_STATE_SLICED) {
 451:Src/ninja_fruit_game.c ****         // Draw sliced fruit halves
 452:Src/ninja_fruit_game.c ****         uint32_t elapsed = HAL_GetTick() - fruit->slice_time;
 453:Src/ninja_fruit_game.c ****         float32_t separation = (elapsed / (float32_t)SLICE_ANIMATION_TIME) * FRUIT_SIZE;
 454:Src/ninja_fruit_game.c **** 
 455:Src/ninja_fruit_game.c ****         if (fruit->slice_direction) {
 456:Src/ninja_fruit_game.c ****             // Right slice - left half moves left, right half moves right
 457:Src/ninja_fruit_game.c ****             UTIL_LCD_FillCircle(screen_x - separation/2, screen_y + separation/4, FRUIT_SIZE/3, col
 458:Src/ninja_fruit_game.c ****             UTIL_LCD_FillCircle(screen_x + separation/2, screen_y + separation/4, FRUIT_SIZE/3, col
 459:Src/ninja_fruit_game.c ****         } else {
 460:Src/ninja_fruit_game.c ****             // Left slice
 461:Src/ninja_fruit_game.c ****             UTIL_LCD_FillCircle(screen_x + separation/2, screen_y + separation/4, FRUIT_SIZE/3, col
 462:Src/ninja_fruit_game.c ****             UTIL_LCD_FillCircle(screen_x - separation/2, screen_y + separation/4, FRUIT_SIZE/3, col
 463:Src/ninja_fruit_game.c ****         }
 464:Src/ninja_fruit_game.c ****     }
 465:Src/ninja_fruit_game.c **** }
