 206:Src/ninja_fruit_game.c **** static void UpdateFruits(NinjaGame_t *game)
 207:Src/ninja_fruit_game.c **** {
 208:Src/ninja_fruit_game.c ****     uint32_t current_time = HAL_GetTick();
 209:Src/ninja_fruit_game.c ****     float32_t dt = 0.016f; // Assuming ~60fps update rate
 210:Src/ninja_fruit_game.c **** 
 211:Src/ninja_fruit_game.c ****     for (int i = 0; i < MAX_FRUITS; i++) {
 212:Src/ninja_fruit_game.c ****         Fruit_t *fruit = &game->fruits[i];
 213:Src/ninja_fruit_game.c **** 
 214:Src/ninja_fruit_game.c ****         if (fruit->state == FRUIT_STATE_FALLING) {
 215:Src/ninja_fruit_game.c ****             // Update position
 216:Src/ninja_fruit_game.c ****             fruit->y += fruit->velocity_y * dt;
 217:Src/ninja_fruit_game.c ****             fruit->x += fruit->velocity_x * dt;
 218:Src/ninja_fruit_game.c **** 
 219:Src/ninja_fruit_game.c ****             // Check if fruit fell off screen
 220:Src/ninja_fruit_game.c ****             if (fruit->y > (0.98- (FRUIT_SIZE/2)/SCREEN_HEIGHT)) {
 221:Src/ninja_fruit_game.c ****                 fruit->state = FRUIT_STATE_MISSED;
 222:Src/ninja_fruit_game.c ****                 game->missed_count++;
 223:Src/ninja_fruit_game.c ****             }
 224:Src/ninja_fruit_game.c ****         }
 225:Src/ninja_fruit_game.c ****         else if (fruit->state == FRUIT_STATE_SLICED) {
 226:Src/ninja_fruit_game.c ****             // Remove sliced fruits after animation time
 227:Src/ninja_fruit_game.c ****             if (current_time - fruit->slice_time > SLICE_ANIMATION_TIME) {
 228:Src/ninja_fruit_game.c ****                 fruit->state = FRUIT_STATE_INACTIVE;
 229:Src/ninja_fruit_game.c ****             }
 230:Src/ninja_fruit_game.c ****         }
 231:Src/ninja_fruit_game.c ****         else if (fruit->state == FRUIT_STATE_MISSED) {
 232:Src/ninja_fruit_game.c ****             // Remove missed fruits immediately
 233:Src/ninja_fruit_game.c ****             fruit->state = FRUIT_STATE_INACTIVE;
 234:Src/ninja_fruit_game.c ****         }
 235:Src/ninja_fruit_game.c ****     }
 236:Src/ninja_fruit_game.c **** }
