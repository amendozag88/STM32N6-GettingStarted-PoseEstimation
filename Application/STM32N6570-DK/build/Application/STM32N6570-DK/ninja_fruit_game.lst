 238:Src/ninja_fruit_game.c **** static void CheckSlices(NinjaGame_t *game, SwipeTrajectory_t *swipe)
 239:Src/ninja_fruit_game.c **** {
 240:Src/ninja_fruit_game.c ****     if (!swipe->active) return;
 241:Src/ninja_fruit_game.c **** 
