 250:Src/ninja_fruit_game.c ****                                    swipe->end_x, swipe->end_y,
 251:Src/ninja_fruit_game.c ****                                    fruit->x, fruit->y, radius)) {
 252:Src/ninja_fruit_game.c **** 
