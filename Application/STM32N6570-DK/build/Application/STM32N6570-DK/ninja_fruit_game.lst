 180:Src/ninja_fruit_game.c ****             Fruit_t *fruit = &game->fruits[i];
 181:Src/ninja_fruit_game.c **** 
 182:Src/ninja_fruit_game.c ****             // Random spawn position at top of screen
 183:Src/ninja_fruit_game.c ****             fruit->x = 0.25f + (rand() % 500) / 1000.0f; // Random X between 0.1 and 0.9
 184:Src/ninja_fruit_game.c ****             fruit->y = 0.03 + (FRUIT_SIZE/2)/SCREEN_HEIGHT;
 185:Src/ninja_fruit_game.c **** 
 186:Src/ninja_fruit_game.c ****             // Random horizontal drift
 187:Src/ninja_fruit_game.c ****             fruit->velocity_x = ((rand() % 100) - 50) / 10000.0f; // Small horizontal movement
 188:Src/ninja_fruit_game.c ****             fruit->velocity_y = FRUIT_FALL_SPEED + ((rand() % 50) / 1000.0f); // Random fall speed 
 189:Src/ninja_fruit_game.c **** 
