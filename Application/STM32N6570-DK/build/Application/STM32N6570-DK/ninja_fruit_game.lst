 103:Src/ninja_fruit_game.c ****     // Update difficulty based on time played
 104:Src/ninja_fruit_game.c ****     uint32_t game_time = current_time - game->game_start_time;
 105:Src/ninja_fruit_game.c ****     game->level = (game_time / 30000) + 1; // Increase level every 30 seconds
 106:Src/ninja_fruit_game.c ****     game->spawn_rate_multiplier = 1.0f + (game->level - 1) * 0.3f;
 107:Src/ninja_fruit_game.c **** 
