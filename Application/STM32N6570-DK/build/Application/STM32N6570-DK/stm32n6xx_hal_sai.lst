 552:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       /* (freq x 10) to keep Significant digits */
 553:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       tmpval = (freq * 10U) / (hsai->Init.AudioFrequency * tmpframelength);
