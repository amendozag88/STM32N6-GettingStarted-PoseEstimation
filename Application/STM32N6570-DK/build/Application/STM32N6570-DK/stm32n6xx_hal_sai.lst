ARM GAS  C:\Users\Antonio\AppData\Local\Temp\ccmFwfsh.s 			page 18


 938:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c **** @verbatim
 939:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****   ==============================================================================
 940:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****                       ##### IO operation functions #####
 941:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****   ==============================================================================
 942:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****   [..]
 943:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****     This subsection provides a set of functions allowing to manage the SAI data
 944:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****     transfers.
 945:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c **** 
 946:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****     (+) There are two modes of transfer:
 947:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       (++) Blocking mode : The communication is performed in the polling mode.
 948:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****            The status of all data processing is returned by the same function
 949:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****            after finishing transfer.
 950:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       (++) No-Blocking mode : The communication is performed using Interrupts
 951:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****            or DMA. These functions return the status of the transfer startup.
 952:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****            The end of the data processing will be indicated through the
 953:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****            dedicated SAI IRQ when using Interrupt mode or the DMA IRQ when
 954:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****            using DMA mode.
 955:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c **** 
 956:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****     (+) Blocking mode functions are :
 957:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       (++) HAL_SAI_Transmit()
 958:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       (++) HAL_SAI_Receive()
 959:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c **** 
 960:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****     (+) Non Blocking mode functions with Interrupt are :
 961:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       (++) HAL_SAI_Transmit_IT()
 962:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       (++) HAL_SAI_Receive_IT()
 963:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c **** 
 964:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****     (+) Non Blocking mode functions with DMA are :
 965:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       (++) HAL_SAI_Transmit_DMA()
 966:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       (++) HAL_SAI_Receive_DMA()
 967:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c **** 
 968:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****     (+) A set of Transfer Complete Callbacks are provided in non Blocking mode:
 969:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       (++) HAL_SAI_TxCpltCallback()
 970:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       (++) HAL_SAI_RxCpltCallback()
 971:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c ****       (++) HAL_SAI_ErrorCallback()
 972:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c **** 
 973:../../STM32Cube_FW_N6/Drivers/STM32N6xx_HAL_Driver/Src/stm32n6xx_hal_sai.c **** @endverbatim
